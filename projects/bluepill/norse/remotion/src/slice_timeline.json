  },
  {
   "beat": "N-091",
   "scene": "S39",
   "image": "S39_base.png",
   "move": "crop_close",
   "crop_rect": [
    100,
    480,
    560,
    315
   ],
   "start_s": 298.845,
   "end_s": 300.621,
   "text": "and the serpent bites."
  },
  {
   "beat": "N-092",
   "scene": "S39",
   "image": "S39_v1.png",
   "move": "hold",
   "crop_rect": null,
   "start_s": 300.621,
   "end_s": 304.627,
   "text": "Thor pulls so hard his feet go through the bottom of the boat,"
  },
  {
   "beat": "N-093",
   "scene": "S39",
   "image": "S39_v1.png",
