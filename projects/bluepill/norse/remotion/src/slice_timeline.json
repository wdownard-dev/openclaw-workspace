   "beat": "N-096",
   "scene": "S41",
   "image": "S41_base.png",
   "move": "crop_close",
   "crop_rect": [
    600,
    100,
    840,
    473
   ],
   "start_s": 315.355,
   "end_s": 318.211,
   "text": "Water pours in, Hymir panics,"
  },
