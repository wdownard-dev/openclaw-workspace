   "beat": "N-119",
   "scene": "S48",
   "image": "S48_v1.png",
   "move": "push_in",
   "crop_rect": null,
   "push": {
    "from": 1,
    "to": 1.06
   },
   "start_s": 394.862,
   "end_s": 399.406,
