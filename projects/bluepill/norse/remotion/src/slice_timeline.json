   "beat": "N-089",
   "scene": "S39",
   "image": "S39_base.png",
   "move": "crop_close",
   "crop_rect": [
    400,
    340,
    700,
    394
   ],
   "start_s": 294.584,
   "end_s": 296.975,
   "text": "Thor ties the ox head to a hook,"
  },
  {
   "beat": "N-090",
   "scene": "S39",
   "image": "S39_base.png",
   "move": "hold",
   "crop_rect": null,
   "start_s": 296.975,
   "end_s": 298.845,
