  },
  {
   "beat": "N-088",
   "scene": "S38",
   "image": "S38_base.png",
   "move": "crop_close",
   "crop_rect": [
    760,
    260,
    520,
    293
   ],
   "start_s": 292.813,
   "end_s": 294.584,
