[
 {
  "beat": 1,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "Twelve men follow Odysseus into a cave. Six of them get out.",
  "words": 12,
  "first_word": 0,
  "last_word": 11,
  "start": 0.4,
  "end": 4.804,
  "duration": 4.404,
  "gap_before": null
 },
 {
  "beat": 2,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "A giant ate the other six, the one-eyed kind. So where did he come from?",
  "words": 15,
  "first_word": 12,
  "last_word": 26,
  "start": 5.204,
  "end": 9.808,
  "duration": 4.604,
  "gap_before": 0.4
 },
 {
  "beat": 3,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "We have four suspects, and a verdict on each. One is an elephant skull. Another, you can still walk up to and touch.",
  "words": 23,
  "first_word": 27,
  "last_word": 49,
  "start": 10.208,
  "end": 18.202,
  "duration": 7.994,
  "gap_before": 0.4
 },
 {
  "beat": 4,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "One note before we start. Where Homer gives these characters lines, we have tidied them up. Where he doesn't, we have made a few up.",
  "words": 25,
  "first_word": 50,
  "last_word": 74,
  "start": 18.602,
  "end": 26.999,
  "duration": 8.397,
  "gap_before": 0.4
 },
 {
  "beat": 5,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "But first, a poem. And a very bad decision about cheese.",
  "words": 11,
  "first_word": 75,
  "last_word": 85,
  "start": 27.399,
  "end": 32.24,
  "duration": 4.841,
  "gap_before": 0.4
 },
 {
  "beat": 6,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "Sailing home from Troy, Odysseus lands in the country of the Cyclopes. Book Nine never says where.",
  "words": 17,
  "first_word": 86,
  "last_word": 102,
  "start": 32.59,
  "end": 39.784,
  "duration": 7.194,
  "gap_before": 0.35
 },
 {
  "beat": 7,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "He picks twelve men, takes a goatskin of wine, and walks up to a cave.",
  "words": 15,
  "first_word": 103,
  "last_word": 117,
  "start": 40.184,
  "end": 44.834,
  "duration": 4.65,
  "gap_before": 0.4
 },
 {
  "beat": 8,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "Racks of cheese. Pens full of lambs. Nobody home.",
  "words": 9,
  "first_word": 118,
  "last_word": 126,
  "start": 45.217,
  "end": 49.015,
  "duration": 3.798,
  "gap_before": 0.383
 },
 {
  "beat": 9,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P02",
  "text": "Take the cheese. Let's go.",
  "words": 5,
  "first_word": 127,
  "last_word": 131,
  "start": 49.335,
  "end": 50.995,
  "duration": 1.66,
  "attribution": {
   "text": "the crew urged.",
   "start": 51.245,
   "end": 52.092,
   "first_word": 132,
   "last_word": 134
  },
  "end_with_attribution": 52.092,
  "gap_before": 0.32
 },
 {
  "beat": 10,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P02",
  "text": "No. I want to meet the owner. He might give us a present.",
  "words": 13,
  "first_word": 135,
  "last_word": 147,
  "start": 52.372,
  "end": 55.638,
  "duration": 3.266,
  "attribution": {
   "text": "said Odysseus.",
   "start": 55.882,
   "end": 56.648,
   "first_word": 148,
   "last_word": 149
  },
  "end_with_attribution": 56.648,
  "gap_before": 0.28
 },
 {
  "beat": 11,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "The cleverest man in the poem is waiting for a gift basket from a stranger's cave.",
  "words": 16,
  "first_word": 150,
  "last_word": 165,
  "start": 56.968,
  "end": 61.44,
  "duration": 4.472,
  "gap_before": 0.32
 },
 {
  "beat": 12,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "The owner comes home. He looks less like a man than a wooded peak, standing alone.",
  "words": 16,
  "first_word": 166,
  "last_word": 181,
  "start": 61.84,
  "end": 66.945,
  "duration": 5.105,
  "gap_before": 0.4
 },
 {
  "beat": 13,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "He drives his flock inside, then rolls a stone across the door. Twenty-two wagons could not have moved it.",
  "words": 19,
  "first_word": 182,
  "last_word": 200,
  "start": 67.345,
  "end": 74.124,
  "duration": 6.779,
  "gap_before": 0.4
 },
 {
  "beat": 14,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P03",
  "text": "Strangers, who are you? Traders, or pirates?",
  "words": 7,
  "first_word": 201,
  "last_word": 207,
  "start": 74.524,
  "end": 77.616,
  "duration": 3.092,
  "attribution": {
   "text": "the giant asked.",
   "start": 77.917,
   "end": 78.73,
   "first_word": 208,
   "last_word": 210
  },
  "end_with_attribution": 78.73,
  "gap_before": 0.4
 },
 {
  "beat": 15,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "We are Greeks, heading home from Troy. We ask for hospitality. Remember: Zeus protects guests.",
  "words": 15,
  "first_word": 211,
  "last_word": 225,
  "start": 79.01,
  "end": 85.214,
  "duration": 6.204,
  "gap_before": 0.28
 },
 {
  "beat": 16,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P03",
  "text": "Zeus? We Cyclopes don't care about Zeus. We are stronger than the gods.",
  "words": 13,
  "first_word": 226,
  "last_word": 238,
  "start": 85.494,
  "end": 90.061,
  "duration": 4.567,
  "gap_before": 0.28
 },
 {
  "beat": 17,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P03",
  "text": "That is not a good answer. He grabs two of the men for supper, then falls asleep among his sheep.",
  "words": 20,
  "first_word": 239,
  "last_word": 258,
  "start": 90.381,
  "end": 95.962,
  "duration": 5.581,
  "gap_before": 0.32
 },
 {
  "beat": 18,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "He is asleep. I could kill him right now.",
  "words": 9,
  "first_word": 259,
  "last_word": 267,
  "start": 96.282,
  "end": 98.606,
  "duration": 2.324,
  "attribution": {
   "text": "Odysseus thought.",
   "start": 98.856,
   "end": 99.669,
   "first_word": 268,
   "last_word": 269
  },
  "end_with_attribution": 99.669,
  "gap_before": 0.32
 },
 {
  "beat": 19,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "And then who moves the stone?",
  "words": 6,
  "first_word": 270,
  "last_word": 275,
  "start": 99.949,
  "end": 101.424,
  "duration": 1.475,
  "gap_before": 0.28
 },
 {
  "beat": 20,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "Ah.",
  "words": 1,
  "first_word": 276,
  "last_word": 276,
  "start": 101.974,
  "end": 102.334,
  "duration": 0.36,
  "gap_before": 0.55
 },
 {
  "beat": 21,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P03",
  "text": "At breakfast, two more men go. Homer gives the details. We will spare you.",
  "words": 14,
  "first_word": 277,
  "last_word": 290,
  "start": 102.654,
  "end": 108.042,
  "duration": 5.388,
  "gap_before": 0.32
 },
 {
  "beat": 22,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "Odysseus finds the giant's own club, an olive trunk as big as a ship's mast. He cuts off a length, sharpens it, and hardens the point in the fire.",
  "words": 29,
  "first_word": 291,
  "last_word": 319,
  "start": 108.392,
  "end": 118.228,
  "duration": 9.836,
  "gap_before": 0.35
 },
 {
  "beat": 23,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "Who helps me carry the stake? Draw lots.",
  "words": 8,
  "first_word": 320,
  "last_word": 327,
  "start": 118.548,
  "end": 121.218,
  "duration": 2.67,
  "attribution": {
   "text": "said Odysseus.",
   "start": 121.468,
   "end": 122.28,
   "first_word": 328,
   "last_word": 329
  },
  "end_with_attribution": 122.28,
  "gap_before": 0.32
 },
 {
  "beat": 24,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P04",
  "text": "And if he wakes up?",
  "words": 5,
  "first_word": 330,
  "last_word": 334,
  "start": 122.56,
  "end": 123.512,
  "duration": 0.952,
  "attribution": {
   "text": "a crewman asked.",
   "start": 123.837,
   "end": 124.673,
   "first_word": 335,
   "last_word": 337
  },
  "end_with_attribution": 124.673,
  "gap_before": 0.28
 },
 {
  "beat": 25,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "Then it was a short plan.",
  "words": 6,
  "first_word": 338,
  "last_word": 343,
  "start": 124.953,
  "end": 126.695,
  "duration": 1.742,
  "gap_before": 0.28
 },
 {
  "beat": 26,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "He hides the stake under dung, the one thing a cave full of sheep has plenty of.",
  "words": 17,
  "first_word": 344,
  "last_word": 360,
  "start": 127.015,
  "end": 132.19,
  "duration": 5.175,
  "gap_before": 0.32
 },
 {
  "beat": 27,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "That evening, two more. Six men gone.",
  "words": 7,
  "first_word": 361,
  "last_word": 367,
  "start": 132.59,
  "end": 135.885,
  "duration": 3.295,
  "gap_before": 0.4
 },
 {
  "beat": 28,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "You have eaten a great deal of man's flesh, Cyclops. Have some wine.",
  "words": 13,
  "first_word": 368,
  "last_word": 380,
  "start": 136.205,
  "end": 140.384,
  "duration": 4.179,
  "attribution": {
   "text": "said Odysseus, quite calmly.",
   "start": 140.454,
   "end": 142.021,
   "first_word": 381,
   "last_word": 384
  },
  "end_with_attribution": 142.021,
  "gap_before": 0.32
 },
 {
  "beat": 29,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "The wine comes from a priest of Apollo, whose household drank it mixed twenty parts water to one. The giant drinks three bowls. Homer counts.",
  "words": 25,
  "first_word": 385,
  "last_word": 409,
  "start": 142.341,
  "end": 151.372,
  "duration": 9.031,
  "gap_before": 0.32
 },
 {
  "beat": 30,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P04",
  "text": "More. Now tell me your name, and I will give you a present.",
  "words": 13,
  "first_word": 410,
  "last_word": 422,
  "start": 151.692,
  "end": 155.297,
  "duration": 3.605,
  "attribution": {
   "text": "the giant rumbled.",
   "start": 155.541,
   "end": 156.493,
   "first_word": 423,
   "last_word": 425
  },
  "end_with_attribution": 156.493,
  "gap_before": 0.32
 },
 {
  "beat": 31,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "My name is Nobody.",
  "words": 4,
  "first_word": 426,
  "last_word": 429,
  "start": 156.773,
  "end": 157.829,
  "duration": 1.056,
  "attribution": {
   "text": "said Odysseus.",
   "start": 158.062,
   "end": 158.793,
   "first_word": 430,
   "last_word": 431
  },
  "end_with_attribution": 158.793,
  "gap_before": 0.28
 },
 {
  "beat": 32,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P04",
  "text": "Nobody. Then here is my present, Nobody. I will eat Nobody's friends first, and Nobody last.",
  "words": 16,
  "first_word": 432,
  "last_word": 447,
  "start": 159.073,
  "end": 165.771,
  "duration": 6.698,
  "gap_before": 0.28
 },
 {
  "beat": 33,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "I am honoured.",
  "words": 3,
  "first_word": 448,
  "last_word": 450,
  "start": 166.051,
  "end": 166.689,
  "duration": 0.638,
  "gap_before": 0.28
 },
 {
  "beat": 34,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "It does buy time.",
  "words": 4,
  "first_word": 451,
  "last_word": 454,
  "start": 167.009,
  "end": 168.159,
  "duration": 1.15,
  "gap_before": 0.32
 },
 {
  "beat": 35,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P05",
  "text": "The giant passes out. Odysseus puts the stake in the fire. Then he puts it in the eye.",
  "words": 18,
  "first_word": 455,
  "last_word": 472,
  "start": 168.509,
  "end": 173.922,
  "duration": 5.413,
  "gap_before": 0.35
 },
 {
  "beat": 36,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P05",
  "text": "Homer reaches for a blacksmith's simile: an axe plunged into cold water, hissing.",
  "words": 13,
  "first_word": 473,
  "last_word": 485,
  "start": 174.322,
  "end": 179.756,
  "duration": 5.434,
  "gap_before": 0.4
 },
 {
  "beat": 37,
  "type": "line",
  "spoken": true,
  "speaker": "CYC2",
  "passage": "P05",
  "text": "Polyphemus, what is wrong? Is someone killing you?",
  "words": 8,
  "first_word": 486,
  "last_word": 493,
  "start": 180.076,
  "end": 183.038,
  "duration": 2.962,
  "attribution": {
   "text": "a Cyclops asked, bored.",
   "start": 183.387,
   "end": 185.024,
   "first_word": 494,
   "last_word": 497
  },
  "end_with_attribution": 185.024,
  "gap_before": 0.32
 },
 {
  "beat": 38,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P05",
  "text": "Nobody is killing me by trickery! Nobody is killing me by force!",
  "words": 12,
  "first_word": 498,
  "last_word": 509,
  "start": 185.304,
  "end": 189.309,
  "duration": 4.005,
  "attribution": {
   "text": "the giant bellowed.",
   "start": 189.599,
   "end": 190.609,
   "first_word": 510,
   "last_word": 512
  },
  "end_with_attribution": 190.609,
  "gap_before": 0.28
 },
 {
  "beat": 39,
  "type": "line",
  "spoken": true,
  "speaker": "CYC2",
  "passage": "P05",
  "text": "Then nobody is hurting you. It must be a sickness from Zeus. Pray to your father, and let us sleep.",
  "words": 20,
  "first_word": 513,
  "last_word": 532,
  "start": 190.889,
  "end": 196.951,
  "duration": 6.062,
  "attribution": {
   "text": "the Cyclops said flatly.",
   "start": 197.201,
   "end": 198.688,
   "first_word": 533,
   "last_word": 536
  },
  "end_with_attribution": 198.688,
  "gap_before": 0.28
 },
 {
  "beat": 40,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P05",
  "text": "The Cyclopes have no laws, no assemblies, and no follow-up questions.",
  "words": 11,
  "first_word": 537,
  "last_word": 547,
  "start": 199.008,
  "end": 203.582,
  "duration": 4.574,
  "gap_before": 0.32
 },
 {
  "beat": 41,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "At dawn the sheep file out. Odysseus has tied them in threes, with a man hanging under each middle one.",
  "words": 20,
  "first_word": 548,
  "last_word": 567,
  "start": 203.932,
  "end": 210.572,
  "duration": 6.64,
  "gap_before": 0.35
 },
 {
  "beat": 42,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "He hangs under the best ram himself. The blinded giant feels along their backs.",
  "words": 14,
  "first_word": 568,
  "last_word": 581,
  "start": 210.972,
  "end": 216.05,
  "duration": 5.078,
  "gap_before": 0.4
 },
 {
  "beat": 43,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "Their backs. Not their bellies.",
  "words": 5,
  "first_word": 582,
  "last_word": 586,
  "start": 216.45,
  "end": 218.333,
  "duration": 1.883,
  "gap_before": 0.4
 },
 {
  "beat": 44,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P06",
  "text": "My good ram. You are always first out. Why are you last today? Are you sorry for your master's eye?",
  "words": 20,
  "first_word": 587,
  "last_word": 606,
  "start": 218.653,
  "end": 225.307,
  "duration": 6.654,
  "attribution": {
   "text": "the giant said softly.",
   "start": 225.657,
   "end": 227.132,
   "first_word": 607,
   "last_word": 610
  },
  "end_with_attribution": 227.132,
  "gap_before": 0.32
 },
 {
  "beat": 45,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "The most sincere conversation in the poem.",
  "words": 7,
  "first_word": 611,
  "last_word": 617,
  "start": 227.452,
  "end": 230.068,
  "duration": 2.616,
  "gap_before": 0.32
 },
 {
  "beat": 46,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "Odysseus should sail away quietly. He has won.",
  "words": 8,
  "first_word": 618,
  "last_word": 625,
  "start": 230.468,
  "end": 233.86,
  "duration": 3.392,
  "gap_before": 0.4
 },
 {
  "beat": 47,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "Instead, he jeers at the giant from the deck. The giant tears the top off a mountain and throws it.",
  "words": 20,
  "first_word": 626,
  "last_word": 645,
  "start": 234.26,
  "end": 240.729,
  "duration": 6.469,
  "gap_before": 0.4
 },
 {
  "beat": 48,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "It lands just in front of the ship, a whisker from the rudder, and the wave carries the ship back toward shore.",
  "words": 22,
  "first_word": 646,
  "last_word": 667,
  "start": 241.129,
  "end": 247.412,
  "duration": 6.283,
  "gap_before": 0.4
 },
 {
  "beat": 49,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P07",
  "text": "Please stop. He already threw one rock. He can throw another.",
  "words": 11,
  "first_word": 668,
  "last_word": 678,
  "start": 247.812,
  "end": 251.45,
  "duration": 3.638,
  "attribution": {
   "text": "the crew begged.",
   "start": 251.7,
   "end": 252.501,
   "first_word": 679,
   "last_word": 681
  },
  "end_with_attribution": 252.501,
  "gap_before": 0.4
 },
 {
  "beat": 50,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P07",
  "text": "Cyclops. If anyone asks who blinded you, tell them it was Odysseus. Son of Laertes. Of Ithaca.",
  "words": 17,
  "first_word": 682,
  "last_word": 698,
  "start": 252.781,
  "end": 260.082,
  "duration": 7.301,
  "gap_before": 0.28
 },
 {
  "beat": 51,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P07",
  "text": "Nobody lasted one night.",
  "words": 4,
  "first_word": 699,
  "last_word": 702,
  "start": 260.402,
  "end": 261.842,
  "duration": 1.44,
  "gap_before": 0.32
 },
 {
  "beat": 52,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P07",
  "text": "A prophet told me Odysseus would take my eye. I expected a warrior. I got a weakling who got me drunk. Come back, and I will give you presents.",
  "words": 29,
  "first_word": 703,
  "last_word": 731,
  "start": 262.162,
  "end": 271.464,
  "duration": 9.302,
  "attribution": {
   "text": "the giant called.",
   "start": 271.714,
   "end": 272.608,
   "first_word": 732,
   "last_word": 734
  },
  "end_with_attribution": 272.608,
  "gap_before": 0.32
 },
 {
  "beat": 53,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P07",
  "text": "Keep your presents. I would send you to Hades if I could. Not even Poseidon will heal that eye.",
  "words": 19,
  "first_word": 735,
  "last_word": 753,
  "start": 272.888,
  "end": 278.66,
  "duration": 5.772,
  "gap_before": 0.28
 },
 {
  "beat": 54,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P07",
  "text": "Father Poseidon, hear me. Never let Odysseus reach his home. Or if he must, let him come late, in misery, and with all his men lost.",
  "words": 26,
  "first_word": 754,
  "last_word": 779,
  "start": 278.94,
  "end": 288.758,
  "duration": 9.818,
  "attribution": {
   "text": "the giant prayed.",
   "start": 289.008,
   "end": 289.972,
   "first_word": 780,
   "last_word": 782
  },
  "end_with_attribution": 289.972,
  "gap_before": 0.28
 },
 {
  "beat": 55,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Poseidon listens. It will be years before Odysseus sees Ithaca again.",
  "words": 11,
  "first_word": 783,
  "last_word": 793,
  "start": 290.322,
  "end": 294.922,
  "duration": 4.6,
  "gap_before": 0.35
 },
 {
  "beat": 56,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Now search Book Nine for the words \"one eye\". Homer never writes them, and he never mentions a forehead. He says \"the eye\".",
  "words": 23,
  "first_word": 794,
  "last_word": 816,
  "start": 295.322,
  "end": 303.359,
  "duration": 8.037,
  "gap_before": 0.4
 },
 {
  "beat": 57,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Homer takes it for granted. If you want it spelled out, you need a different poet. So where did the Cyclops come from?",
  "words": 23,
  "first_word": 817,
  "last_word": 839,
  "start": 303.788,
  "end": 310.438,
  "duration": 6.65,
  "gap_before": 0.429
 },
 {
  "beat": 58,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Time to open the case.",
  "words": 5,
  "first_word": 840,
  "last_word": 844,
  "start": 310.838,
  "end": 312.568,
  "duration": 1.73,
  "gap_before": 0.4
 },
 {
  "beat": 59,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 1: THE DWARF ELEPHANT",
  "start": 312.893,
  "end": 312.893,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 60,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "Ice Age Sicily had elephants, and island life shrank them until the smallest stood under a metre. You could have looked one in the eye.",
  "words": 25,
  "first_word": 845,
  "last_word": 869,
  "start": 313.018,
  "end": 321.739,
  "duration": 8.721,
  "gap_before": 0.45
 },
 {
  "beat": 61,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "Their bones have turned up in caves on Sicily and Malta. Head-on, the skull shows two small eye sockets at the sides, and in the middle, one enormous hole.",
  "words": 29,
  "first_word": 870,
  "last_word": 898,
  "start": 322.139,
  "end": 332.956,
  "duration": 10.817,
  "gap_before": 0.4
 },
 {
  "beat": 62,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "In 1914, a palaeontologist named Abel imagined sailors finding a skull like this in a beach cave. He thought it might be where the Cyclops came from.",
  "words": 27,
  "first_word": 899,
  "last_word": 925,
  "start": 333.356,
  "end": 343.038,
  "duration": 9.682,
  "gap_before": 0.4
 },
 {
  "beat": 63,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "Here is our version. A sailor ducks in to light a fire.",
  "words": 12,
  "first_word": 926,
  "last_word": 937,
  "start": 343.438,
  "end": 347.584,
  "duration": 4.146,
  "gap_before": 0.4
 },
 {
  "beat": 64,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P09",
  "text": "Hello?",
  "words": 1,
  "first_word": 938,
  "last_word": 938,
  "start": 347.904,
  "end": 348.299,
  "duration": 0.395,
  "attribution": {
   "text": "the sailor asked.",
   "start": 348.649,
   "end": 349.462,
   "first_word": 939,
   "last_word": 941
  },
  "end_with_attribution": 349.462,
  "gap_before": 0.32
 },
 {
  "beat": 65,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "In the clay, something looks back at him. One enormous eye.",
  "words": 11,
  "first_word": 942,
  "last_word": 952,
  "start": 349.782,
  "end": 353.969,
  "duration": 4.187,
  "gap_before": 0.32
 },
 {
  "beat": 66,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P09",
  "text": "Nope.",
  "words": 1,
  "first_word": 953,
  "last_word": 953,
  "start": 354.289,
  "end": 354.754,
  "duration": 0.465,
  "gap_before": 0.32
 },
 {
  "beat": 67,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "The sailor is imagined. The skulls are real.",
  "words": 8,
  "first_word": 954,
  "last_word": 961,
  "start": 355.074,
  "end": 358.163,
  "duration": 3.089,
  "gap_before": 0.32
 },
 {
  "beat": 68,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P10",
  "text": "Where's the nose?",
  "words": 3,
  "first_word": 962,
  "last_word": 964,
  "start": 358.563,
  "end": 359.666,
  "duration": 1.103,
  "gap_before": 0.4
 },
 {
  "beat": 69,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "You are looking at it. That hole is a nasal cavity. To someone who had never seen an elephant, it could pass for one very large eye.",
  "words": 27,
  "first_word": 965,
  "last_word": 991,
  "start": 359.986,
  "end": 369.294,
  "duration": 9.308,
  "gap_before": 0.32
 },
 {
  "beat": 70,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "Discover magazine adds that before Alexander the Great, most Greeks had never seen a live elephant. A skull could easily have baffled them.",
  "words": 23,
  "first_word": 992,
  "last_word": 1014,
  "start": 369.694,
  "end": 378.146,
  "duration": 8.452,
  "gap_before": 0.4
 },
 {
  "beat": 71,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "The folklorist Adrienne Mayor is the theory's best-known champion. Asked about the Cyclops, she is careful.",
  "words": 16,
  "first_word": 1015,
  "last_word": 1030,
  "start": 378.546,
  "end": 385.556,
  "duration": 7.01,
  "gap_before": 0.4
 },
 {
  "beat": 72,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "\"I don't like to say that the fossils inspired, or were the source of the story, because we just can't prove that.\"",
  "words": 22,
  "first_word": 1031,
  "last_word": 1052,
  "start": 385.956,
  "end": 392.297,
  "duration": 6.341,
  "gap_before": 0.4
 },
 {
  "beat": 73,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "That is the theory's best friend, on the record. She does think fossils shaped how Greeks pictured giants. She just won't say they started this one.",
  "words": 26,
  "first_word": 1053,
  "last_word": 1078,
  "start": 392.697,
  "end": 402.061,
  "duration": 9.364,
  "gap_before": 0.4
 },
 {
  "beat": 74,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Then there is the famous version. In Abel's telling, the philosopher Empedocles reported such bones on Sicily and took them for giants.",
  "words": 22,
  "first_word": 1079,
  "last_word": 1100,
  "start": 402.411,
  "end": 411.48,
  "duration": 9.069,
  "gap_before": 0.35
 },
 {
  "beat": 75,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P11",
  "text": "Which ancient book says that?",
  "words": 5,
  "first_word": 1101,
  "last_word": 1105,
  "start": 411.8,
  "end": 413.159,
  "duration": 1.359,
  "attribution": {
   "text": "the sailor asked.",
   "start": 413.414,
   "end": 414.262,
   "first_word": 1106,
   "last_word": 1108
  },
  "end_with_attribution": 414.262,
  "gap_before": 0.32
 },
 {
  "beat": 76,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "None that survives. The translator Jason Colavito calls it \"a modern myth invented, apparently, by Abel himself.\"",
  "words": 17,
  "first_word": 1109,
  "last_word": 1125,
  "start": 414.582,
  "end": 422.293,
  "duration": 7.711,
  "gap_before": 0.32
 },
 {
  "beat": 80,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Possible. Provable? No.",
  "words": 3,
  "first_word": 1126,
  "last_word": 1128,
  "start": 422.993,
  "end": 425.238,
  "duration": 2.245,
  "gap_before": 0.7
 },
 {
  "beat": 81,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 2: THE SMITHS",
  "start": 425.563,
  "end": 425.563,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 82,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "Suspect two lives in a different poem, with a different job.",
  "words": 11,
  "first_word": 1129,
  "last_word": 1139,
  "start": 425.688,
  "end": 428.945,
  "duration": 3.257,
  "gap_before": 0.45
 },
 {
  "beat": 83,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "Hesiod, around seven hundred BC, has three Cyclopes: Thunder, Lightning and Bright.",
  "words": 12,
  "first_word": 1140,
  "last_word": 1151,
  "start": 429.345,
  "end": 435.417,
  "duration": 6.072,
  "gap_before": 0.4
 },
 {
  "beat": 84,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "They make the thunderbolt for Zeus. The Cyclopes of Book Nine shrug Zeus off.",
  "words": 14,
  "first_word": 1152,
  "last_word": 1165,
  "start": 435.817,
  "end": 440.405,
  "duration": 4.588,
  "gap_before": 0.4
 },
 {
  "beat": 85,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P12",
  "text": "I keep sheep.",
  "words": 3,
  "first_word": 1166,
  "last_word": 1168,
  "start": 440.725,
  "end": 441.944,
  "duration": 1.219,
  "attribution": {
   "text": "the giant said awkwardly.",
   "start": 442.194,
   "end": 443.598,
   "first_word": 1169,
   "last_word": 1172
  },
  "end_with_attribution": 443.598,
  "gap_before": 0.32
 },
 {
  "beat": 86,
  "type": "line",
  "spoken": true,
  "speaker": "CYC2",
  "passage": "P12",
  "text": "Sheep.",
  "words": 1,
  "first_word": 1173,
  "last_word": 1173,
  "start": 443.878,
  "end": 444.285,
  "duration": 0.407,
  "gap_before": 0.28
 },
 {
  "beat": 87,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "Hesiod's Cyclopes have careers.",
  "words": 4,
  "first_word": 1174,
  "last_word": 1177,
  "start": 444.605,
  "end": 447.07,
  "duration": 2.465,
  "gap_before": 0.32
 },
 {
  "beat": 88,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "And there it is, the line Book Nine never gave us: one eye only, in the middle of the forehead.",
  "words": 20,
  "first_word": 1178,
  "last_word": 1197,
  "start": 447.47,
  "end": 454.676,
  "duration": 7.206,
  "gap_before": 0.4
 },
 {
  "beat": 90,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "By the fifth century BC, the Cyclopes have a Sicilian address, next to Mount Etna. Euripides sets a comic play there.",
  "words": 21,
  "first_word": 1198,
  "last_word": 1218,
  "start": 455.026,
  "end": 463.186,
  "duration": 8.16,
  "gap_before": 0.35
 },
 {
  "beat": 92,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Thucydides lists the Cyclopes among the earliest people spoken of in Sicily. Then he admits, \"I cannot tell of what race they were.\"",
  "words": 23,
  "first_word": 1219,
  "last_word": 1241,
  "start": 463.586,
  "end": 472.189,
  "duration": 8.603,
  "gap_before": 0.4
 },
 {
  "beat": 93,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Locals, he records, believed the smith god kept a forge on one of the Aeolian islands. Flame by night. Smoke by day.",
  "words": 22,
  "first_word": 1242,
  "last_word": 1263,
  "start": 472.589,
  "end": 480.692,
  "duration": 8.103,
  "gap_before": 0.4
 },
 {
  "beat": 94,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Forges need fire. Sicily had volcanoes. You can see how the two met.",
  "words": 13,
  "first_word": 1264,
  "last_word": 1276,
  "start": 481.092,
  "end": 486.355,
  "duration": 5.263,
  "gap_before": 0.4
 },
 {
  "beat": 95,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "In the third century BC, Theocritus has Polyphemus sing a love song to a sea nymph. He frets about his looks: one long unbroken eyebrow, and one eye.",
  "words": 28,
  "first_word": 1277,
  "last_word": 1304,
  "start": 486.755,
  "end": 498.115,
  "duration": 11.36,
  "gap_before": 0.4
 },
 {
  "beat": 96,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Plausible. Provable? Also no.",
  "words": 4,
  "first_word": 1305,
  "last_word": 1308,
  "start": 498.815,
  "end": 501.521,
  "duration": 2.706,
  "gap_before": 0.7
 },
 {
  "beat": 97,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 3: THE WALLS",
  "start": 501.846,
  "end": 501.846,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 98,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "Suspect three is not a story. You can go and stand next to it.",
  "words": 14,
  "first_word": 1309,
  "last_word": 1322,
  "start": 501.971,
  "end": 505.92,
  "duration": 3.949,
  "gap_before": 0.45
 },
 {
  "beat": 99,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "At Tiryns and Mycenae, Bronze Age walls rise from boulders so big you wonder who lifted them.",
  "words": 17,
  "first_word": 1323,
  "last_word": 1339,
  "start": 506.32,
  "end": 512.401,
  "duration": 6.081,
  "gap_before": 0.4
 },
 {
  "beat": 100,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P14",
  "text": "Who lifted those?",
  "words": 3,
  "first_word": 1340,
  "last_word": 1342,
  "start": 512.721,
  "end": 513.765,
  "duration": 1.044,
  "attribution": {
   "text": "a crewman asked.",
   "start": 513.893,
   "end": 514.764,
   "first_word": 1343,
   "last_word": 1345
  },
  "end_with_attribution": 514.764,
  "gap_before": 0.32
 },
 {
  "beat": 101,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "At Tiryns, the travel writer Pausanias finds stones so big that a pair of mules could not move even the smallest.",
  "words": 21,
  "first_word": 1346,
  "last_word": 1366,
  "start": 515.084,
  "end": 522.682,
  "duration": 7.598,
  "gap_before": 0.32
 },
 {
  "beat": 102,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "He reports that the Cyclopes built that wall, and that Mycenae's wall and Lion Gate are said to be theirs too.",
  "words": 21,
  "first_word": 1367,
  "last_word": 1387,
  "start": 523.082,
  "end": 530.243,
  "duration": 7.161,
  "gap_before": 0.4
 },
 {
  "beat": 103,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "Homer: twenty-two wagons for one door. Pausanias: two mules, and the stone wins. The Greeks measured giants in wagons and mules.",
  "words": 21,
  "first_word": 1388,
  "last_word": 1408,
  "start": 530.643,
  "end": 540.011,
  "duration": 9.368,
  "gap_before": 0.4
 },
 {
  "beat": 104,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "The Lion Gate is about twelve fifty BC. People built it, and later Greeks credited the Cyclopes. Archaeologists still call the style cyclopean masonry.",
  "words": 24,
  "first_word": 1409,
  "last_word": 1432,
  "start": 540.411,
  "end": 550.664,
  "duration": 10.253,
  "gap_before": 0.4
 },
 {
  "beat": 105,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "The wall is real. The giants were the Greeks' explanation for it. It cannot tell us where Homer's giant began.",
  "words": 20,
  "first_word": 1433,
  "last_word": 1452,
  "start": 551.364,
  "end": 558.769,
  "duration": 7.405,
  "gap_before": 0.7
 },
 {
  "beat": 106,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 4: THE FOLKTALE",
  "start": 559.094,
  "end": 559.094,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 107,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Suspect four does not need an elephant, a smith, or a wall. It does not even need Sicily.",
  "words": 18,
  "first_word": 1453,
  "last_word": 1470,
  "start": 559.219,
  "end": 565.389,
  "duration": 6.17,
  "gap_before": 0.45
 },
 {
  "beat": 108,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Strip off the names, and you have a story you have already watched. A man is trapped by a giant, blinds him, and gets away.",
  "words": 25,
  "first_word": 1471,
  "last_word": 1495,
  "start": 565.789,
  "end": 574.392,
  "duration": 8.603,
  "gap_before": 0.4
 },
 {
  "beat": 109,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Scholars have recorded more than two hundred versions. Iceland. Portugal. Russia. Even the Arabian Nights.",
  "words": 15,
  "first_word": 1496,
  "last_word": 1510,
  "start": 574.792,
  "end": 582.343,
  "duration": 7.551,
  "gap_before": 0.4
 },
 {
  "beat": 110,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Most scholars think the tale is older than Homer.",
  "words": 9,
  "first_word": 1511,
  "last_word": 1519,
  "start": 582.743,
  "end": 585.425,
  "duration": 2.682,
  "gap_before": 0.4
 },
 {
  "beat": 111,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P15",
  "text": "So I was not the first.",
  "words": 6,
  "first_word": 1520,
  "last_word": 1525,
  "start": 585.745,
  "end": 587.512,
  "duration": 1.767,
  "attribution": {
   "text": "Odysseus muttered.",
   "start": 587.71,
   "end": 588.615,
   "first_word": 1526,
   "last_word": 1527
  },
  "end_with_attribution": 588.615,
  "gap_before": 0.32
 },
 {
  "beat": 112,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "That does not rule out the skull. It does mean the story does not need one.",
  "words": 16,
  "first_word": 1528,
  "last_word": 1543,
  "start": 588.935,
  "end": 593.619,
  "duration": 4.684,
  "gap_before": 0.32
 },
 {
  "beat": 113,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "On that view, Homer did not invent the Cyclops story. He gave us the best-known version.",
  "words": 16,
  "first_word": 1544,
  "last_word": 1559,
  "start": 594.319,
  "end": 599.958,
  "duration": 5.639,
  "gap_before": 0.7
 },
 {
  "beat": 114,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Four suspects. The smiths have Hesiod. The walls have Pausanias. The folktale has two hundred versions. The elephant has real skulls, and an imaginary sailor.",
  "words": 25,
  "first_word": 1560,
  "last_word": 1584,
  "start": 600.308,
  "end": 611.578,
  "duration": 11.27,
  "gap_before": 0.35
 },
 {
  "beat": 115,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "So was the Cyclops real? As a one-eyed giant who eats sailors, no.",
  "words": 13,
  "first_word": 1585,
  "last_word": 1597,
  "start": 611.978,
  "end": 616.247,
  "duration": 4.269,
  "gap_before": 0.4
 },
 {
  "beat": 116,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P16",
  "text": "Rude.",
  "words": 1,
  "first_word": 1598,
  "last_word": 1598,
  "start": 616.567,
  "end": 617.148,
  "duration": 0.581,
  "gap_before": 0.32
 },
 {
  "beat": 117,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "But the name is real. It was wrapped around a forge, a wall, a story, and perhaps a skull.",
  "words": 19,
  "first_word": 1599,
  "last_word": 1617,
  "start": 617.468,
  "end": 624.478,
  "duration": 7.01,
  "gap_before": 0.32
 },
 {
  "beat": 118,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Who can prove where the Cyclops came from?",
  "words": 8,
  "first_word": 1618,
  "last_word": 1625,
  "start": 624.878,
  "end": 627.398,
  "duration": 2.52,
  "gap_before": 0.4
 },
 {
  "beat": 119,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P16",
  "text": "Nobody.",
  "words": 1,
  "first_word": 1626,
  "last_word": 1626,
  "start": 628.148,
  "end": 628.67,
  "duration": 0.522,
  "gap_before": 0.75
 },
 {
  "beat": 120,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Next time: the wind in the bag, the witch with the wand, and the other monsters of the Odyssey.",
  "words": 19,
  "first_word": 1627,
  "last_word": 1645,
  "start": 628.99,
  "end": 634.006,
  "duration": 5.016,
  "gap_before": 0.32
 },
 {
  "beat": 121,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Odysseus thinks the worst is behind him. He has just told a giant his name, and the giant has a father.",
  "words": 21,
  "first_word": 1646,
  "last_word": 1666,
  "start": 634.406,
  "end": 640.862,
  "duration": 6.456,
  "gap_before": 0.4
 }
