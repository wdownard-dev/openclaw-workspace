[
 {
  "beat": 1,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "Twelve men follow Odysseus into a cave. Six of them get out.",
  "words": 12,
  "first_word": 0,
  "last_word": 11,
  "start": 0.4,
  "end": 4.324,
  "duration": 3.924,
  "gap_before": null
 },
 {
  "beat": 2,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "A giant ate the other six, the one-eyed kind. So where did he come from?",
  "words": 15,
  "first_word": 12,
  "last_word": 26,
  "start": 4.724,
  "end": 9.856,
  "duration": 5.132,
  "gap_before": 0.4
 },
 {
  "beat": 3,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "We have four suspects, and a verdict on each. One is an elephant skull. Another, you can still walk up to and touch.",
  "words": 23,
  "first_word": 27,
  "last_word": 49,
  "start": 10.256,
  "end": 18.824,
  "duration": 8.568,
  "gap_before": 0.4
 },
 {
  "beat": 4,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "One note before we start. Where Homer gives these characters lines, we have tidied them up. Where he doesn't, we have made a few up. Everything else comes from sources.",
  "words": 30,
  "first_word": 50,
  "last_word": 79,
  "start": 19.224,
  "end": 30.73,
  "duration": 11.506,
  "gap_before": 0.4
 },
 {
  "beat": 5,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P01",
  "text": "But first, a poem. And a very bad decision about cheese.",
  "words": 11,
  "first_word": 80,
  "last_word": 90,
  "start": 31.13,
  "end": 35.844,
  "duration": 4.714,
  "gap_before": 0.4
 },
 {
  "beat": 6,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "Sailing home from Troy, Odysseus lands in the country of the Cyclopes. Book Nine never says where.",
  "words": 17,
  "first_word": 91,
  "last_word": 107,
  "start": 36.194,
  "end": 43.717,
  "duration": 7.523,
  "gap_before": 0.35
 },
 {
  "beat": 7,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "He picks twelve men, takes a goatskin of wine, and walks up to a cave.",
  "words": 15,
  "first_word": 108,
  "last_word": 122,
  "start": 44.117,
  "end": 48.866,
  "duration": 4.749,
  "gap_before": 0.4
 },
 {
  "beat": 8,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "Racks of cheese. Pens full of lambs. Nobody home.",
  "words": 9,
  "first_word": 123,
  "last_word": 131,
  "start": 49.249,
  "end": 53.312,
  "duration": 4.063,
  "gap_before": 0.383
 },
 {
  "beat": 9,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P02",
  "text": "Take the cheese. Let's go.",
  "words": 5,
  "first_word": 132,
  "last_word": 136,
  "start": 53.632,
  "end": 55.292,
  "duration": 1.66,
  "attribution": {
   "text": "the crew urged.",
   "start": 55.606,
   "end": 56.453,
   "first_word": 137,
   "last_word": 139
  },
  "end_with_attribution": 56.453,
  "gap_before": 0.32
 },
 {
  "beat": 10,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P02",
  "text": "No. I want to meet the owner. He might give us a present.",
  "words": 13,
  "first_word": 140,
  "last_word": 152,
  "start": 56.733,
  "end": 60.425,
  "duration": 3.692,
  "attribution": {
   "text": "said Odysseus.",
   "start": 60.669,
   "end": 61.435,
   "first_word": 153,
   "last_word": 154
  },
  "end_with_attribution": 61.435,
  "gap_before": 0.28
 },
 {
  "beat": 11,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "The cleverest man in the poem is waiting for a gift basket from a stranger's cave.",
  "words": 16,
  "first_word": 155,
  "last_word": 170,
  "start": 61.755,
  "end": 66.538,
  "duration": 4.783,
  "gap_before": 0.32
 },
 {
  "beat": 12,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "The owner comes home. He looks less like a man than a wooded peak, standing alone.",
  "words": 16,
  "first_word": 171,
  "last_word": 186,
  "start": 66.938,
  "end": 72.43,
  "duration": 5.492,
  "gap_before": 0.4
 },
 {
  "beat": 13,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P02",
  "text": "He drives his flock inside, then rolls a stone across the door. Twenty-two wagons could not have moved it.",
  "words": 19,
  "first_word": 187,
  "last_word": 205,
  "start": 72.83,
  "end": 80.609,
  "duration": 7.779,
  "gap_before": 0.4
 },
 {
  "beat": 14,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P03",
  "text": "Strangers, who are you? Traders, or pirates?",
  "words": 7,
  "first_word": 206,
  "last_word": 212,
  "start": 81.009,
  "end": 84.725,
  "duration": 3.716,
  "attribution": {
   "text": "the giant asked.",
   "start": 85.026,
   "end": 85.839,
   "first_word": 213,
   "last_word": 215
  },
  "end_with_attribution": 85.839,
  "gap_before": 0.4
 },
 {
  "beat": 15,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "We are Greeks, heading home from Troy. We ask for hospitality. Remember: Zeus protects guests.",
  "words": 15,
  "first_word": 216,
  "last_word": 230,
  "start": 86.119,
  "end": 93.329,
  "duration": 7.21,
  "gap_before": 0.28
 },
 {
  "beat": 16,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P03",
  "text": "Zeus? We Cyclopes don't care about Zeus. We are stronger than the gods.",
  "words": 13,
  "first_word": 231,
  "last_word": 243,
  "start": 93.609,
  "end": 98.485,
  "duration": 4.876,
  "gap_before": 0.28
 },
 {
  "beat": 17,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P03",
  "text": "That is not a good answer. He grabs two of the men for supper, then falls asleep among his sheep.",
  "words": 20,
  "first_word": 244,
  "last_word": 263,
  "start": 98.805,
  "end": 105.074,
  "duration": 6.269,
  "gap_before": 0.32
 },
 {
  "beat": 18,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "He is asleep. I could kill him right now.",
  "words": 9,
  "first_word": 264,
  "last_word": 272,
  "start": 105.394,
  "end": 107.983,
  "duration": 2.589,
  "attribution": {
   "text": "Odysseus thought.",
   "start": 108.412,
   "end": 109.225,
   "first_word": 273,
   "last_word": 274
  },
  "end_with_attribution": 109.225,
  "gap_before": 0.32
 },
 {
  "beat": 19,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "And then who moves the stone?",
  "words": 6,
  "first_word": 275,
  "last_word": 280,
  "start": 109.505,
  "end": 110.98,
  "duration": 1.475,
  "gap_before": 0.28
 },
 {
  "beat": 20,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P03",
  "text": "Ah.",
  "words": 1,
  "first_word": 281,
  "last_word": 281,
  "start": 111.53,
  "end": 111.89,
  "duration": 0.36,
  "gap_before": 0.55
 },
 {
  "beat": 21,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P03",
  "text": "At breakfast, two more men go. Homer gives the details. We will spare you.",
  "words": 14,
  "first_word": 282,
  "last_word": 295,
  "start": 112.21,
  "end": 118.7,
  "duration": 6.49,
  "gap_before": 0.32
 },
 {
  "beat": 22,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "Odysseus finds the giant's own club, an olive trunk as big as a ship's mast. He cuts off a length, sharpens it, and hardens the point in the fire.",
  "words": 29,
  "first_word": 296,
  "last_word": 324,
  "start": 119.05,
  "end": 129.29,
  "duration": 10.24,
  "gap_before": 0.35
 },
 {
  "beat": 23,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "Who helps me carry the stake? Draw lots.",
  "words": 8,
  "first_word": 325,
  "last_word": 332,
  "start": 129.61,
  "end": 132.28,
  "duration": 2.67,
  "attribution": {
   "text": "said Odysseus.",
   "start": 132.571,
   "end": 133.383,
   "first_word": 333,
   "last_word": 334
  },
  "end_with_attribution": 133.383,
  "gap_before": 0.32
 },
 {
  "beat": 24,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P04",
  "text": "And if he wakes up?",
  "words": 5,
  "first_word": 335,
  "last_word": 339,
  "start": 133.663,
  "end": 134.615,
  "duration": 0.952,
  "attribution": {
   "text": "a crewman asked.",
   "start": 134.94,
   "end": 135.776,
   "first_word": 340,
   "last_word": 342
  },
  "end_with_attribution": 135.776,
  "gap_before": 0.28
 },
 {
  "beat": 25,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "Then it was a short plan.",
  "words": 6,
  "first_word": 343,
  "last_word": 348,
  "start": 136.056,
  "end": 137.798,
  "duration": 1.742,
  "gap_before": 0.28
 },
 {
  "beat": 26,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "He hides the stake under dung, the one thing a cave full of sheep has plenty of.",
  "words": 17,
  "first_word": 349,
  "last_word": 365,
  "start": 138.118,
  "end": 143.679,
  "duration": 5.561,
  "gap_before": 0.32
 },
 {
  "beat": 27,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "That evening, two more. Six men gone.",
  "words": 7,
  "first_word": 366,
  "last_word": 372,
  "start": 144.079,
  "end": 147.725,
  "duration": 3.646,
  "gap_before": 0.4
 },
 {
  "beat": 28,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "You have eaten a great deal of man's flesh, Cyclops. Have some wine.",
  "words": 13,
  "first_word": 373,
  "last_word": 385,
  "start": 148.045,
  "end": 152.224,
  "duration": 4.179,
  "attribution": {
   "text": "said Odysseus, quite calmly.",
   "start": 152.294,
   "end": 153.861,
   "first_word": 386,
   "last_word": 389
  },
  "end_with_attribution": 153.861,
  "gap_before": 0.32
 },
 {
  "beat": 29,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "The wine comes from a priest of Apollo, whose household drank it mixed twenty parts water to one. The giant drinks three bowls. Homer counts.",
  "words": 25,
  "first_word": 390,
  "last_word": 414,
  "start": 154.181,
  "end": 163.573,
  "duration": 9.392,
  "gap_before": 0.32
 },
 {
  "beat": 30,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P04",
  "text": "More. Now tell me your name, and I will give you a present.",
  "words": 13,
  "first_word": 415,
  "last_word": 427,
  "start": 163.893,
  "end": 167.55,
  "duration": 3.657,
  "attribution": {
   "text": "the giant rumbled.",
   "start": 167.794,
   "end": 168.746,
   "first_word": 428,
   "last_word": 430
  },
  "end_with_attribution": 168.746,
  "gap_before": 0.32
 },
 {
  "beat": 31,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "My name is Nobody.",
  "words": 4,
  "first_word": 431,
  "last_word": 434,
  "start": 169.026,
  "end": 170.082,
  "duration": 1.056,
  "attribution": {
   "text": "said Odysseus.",
   "start": 170.315,
   "end": 171.046,
   "first_word": 435,
   "last_word": 436
  },
  "end_with_attribution": 171.046,
  "gap_before": 0.28
 },
 {
  "beat": 32,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P04",
  "text": "Nobody. Then here is my present, Nobody. I will eat Nobody's friends first, and Nobody last.",
  "words": 16,
  "first_word": 437,
  "last_word": 452,
  "start": 171.326,
  "end": 178.64,
  "duration": 7.314,
  "gap_before": 0.28
 },
 {
  "beat": 33,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P04",
  "text": "I am honoured.",
  "words": 3,
  "first_word": 453,
  "last_word": 455,
  "start": 178.92,
  "end": 179.558,
  "duration": 0.638,
  "gap_before": 0.28
 },
 {
  "beat": 34,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P04",
  "text": "It does buy time.",
  "words": 4,
  "first_word": 456,
  "last_word": 459,
  "start": 179.878,
  "end": 181.028,
  "duration": 1.15,
  "gap_before": 0.32
 },
 {
  "beat": 35,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P05",
  "text": "The giant passes out. Odysseus puts the stake in the fire. Then he puts it in the eye.",
  "words": 18,
  "first_word": 460,
  "last_word": 477,
  "start": 181.378,
  "end": 187.276,
  "duration": 5.898,
  "gap_before": 0.35
 },
 {
  "beat": 36,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P05",
  "text": "Homer reaches for a blacksmith's simile: an axe plunged into cold water, hissing.",
  "words": 13,
  "first_word": 478,
  "last_word": 490,
  "start": 187.676,
  "end": 193.365,
  "duration": 5.689,
  "gap_before": 0.4
 },
 {
  "beat": 37,
  "type": "line",
  "spoken": true,
  "speaker": "CYC2",
  "passage": "P05",
  "text": "Polyphemus, what is wrong? Is someone killing you?",
  "words": 8,
  "first_word": 491,
  "last_word": 498,
  "start": 193.685,
  "end": 196.773,
  "duration": 3.088,
  "attribution": {
   "text": "a Cyclops asked, bored.",
   "start": 197.122,
   "end": 198.759,
   "first_word": 499,
   "last_word": 502
  },
  "end_with_attribution": 198.759,
  "gap_before": 0.32
 },
 {
  "beat": 38,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P05",
  "text": "Nobody is killing me by trickery! Nobody is killing me by force!",
  "words": 12,
  "first_word": 503,
  "last_word": 514,
  "start": 199.039,
  "end": 203.044,
  "duration": 4.005,
  "attribution": {
   "text": "the giant bellowed.",
   "start": 203.334,
   "end": 204.344,
   "first_word": 515,
   "last_word": 517
  },
  "end_with_attribution": 204.344,
  "gap_before": 0.28
 },
 {
  "beat": 39,
  "type": "line",
  "spoken": true,
  "speaker": "CYC2",
  "passage": "P05",
  "text": "Then nobody is hurting you. It must be a sickness from Zeus. Pray to your father, and let us sleep.",
  "words": 20,
  "first_word": 518,
  "last_word": 537,
  "start": 204.624,
  "end": 210.812,
  "duration": 6.188,
  "attribution": {
   "text": "the Cyclops said flatly.",
   "start": 211.311,
   "end": 212.798,
   "first_word": 538,
   "last_word": 541
  },
  "end_with_attribution": 212.798,
  "gap_before": 0.28
 },
 {
  "beat": 40,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P05",
  "text": "The Cyclopes have no laws, no assemblies, and no follow-up questions.",
  "words": 11,
  "first_word": 542,
  "last_word": 552,
  "start": 213.118,
  "end": 217.692,
  "duration": 4.574,
  "gap_before": 0.32
 },
 {
  "beat": 41,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "At dawn the sheep file out. Odysseus has tied them in threes, with a man hanging under each middle one.",
  "words": 20,
  "first_word": 553,
  "last_word": 572,
  "start": 218.042,
  "end": 225.368,
  "duration": 7.326,
  "gap_before": 0.35
 },
 {
  "beat": 42,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "He hangs under the best ram himself. The blinded giant feels along their backs.",
  "words": 14,
  "first_word": 573,
  "last_word": 586,
  "start": 225.768,
  "end": 231.341,
  "duration": 5.573,
  "gap_before": 0.4
 },
 {
  "beat": 43,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "Their backs. Not their bellies.",
  "words": 5,
  "first_word": 587,
  "last_word": 591,
  "start": 231.741,
  "end": 233.866,
  "duration": 2.125,
  "gap_before": 0.4
 },
 {
  "beat": 44,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P06",
  "text": "My good ram. You are always first out. Why are you last today? Are you sorry for your master's eye?",
  "words": 20,
  "first_word": 592,
  "last_word": 611,
  "start": 234.186,
  "end": 241.012,
  "duration": 6.826,
  "attribution": {
   "text": "the giant said softly.",
   "start": 241.5,
   "end": 242.975,
   "first_word": 612,
   "last_word": 615
  },
  "end_with_attribution": 242.975,
  "gap_before": 0.32
 },
 {
  "beat": 45,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "The most sincere conversation in the poem.",
  "words": 7,
  "first_word": 616,
  "last_word": 622,
  "start": 243.295,
  "end": 246.14,
  "duration": 2.845,
  "gap_before": 0.32
 },
 {
  "beat": 46,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "Odysseus should sail away quietly. He has won.",
  "words": 8,
  "first_word": 623,
  "last_word": 630,
  "start": 246.54,
  "end": 250.081,
  "duration": 3.541,
  "gap_before": 0.4
 },
 {
  "beat": 47,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "Instead, he jeers at the giant from the deck. The giant tears the top off a mountain and throws it.",
  "words": 20,
  "first_word": 631,
  "last_word": 650,
  "start": 250.481,
  "end": 257.354,
  "duration": 6.873,
  "gap_before": 0.4
 },
 {
  "beat": 48,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P06",
  "text": "It lands just in front of the ship, a whisker from the rudder, and the wave carries the ship back toward shore.",
  "words": 22,
  "first_word": 651,
  "last_word": 672,
  "start": 257.754,
  "end": 264.268,
  "duration": 6.514,
  "gap_before": 0.4
 },
 {
  "beat": 49,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P07",
  "text": "Please stop. He already threw one rock. He can throw another.",
  "words": 11,
  "first_word": 673,
  "last_word": 683,
  "start": 264.668,
  "end": 268.558,
  "duration": 3.89,
  "attribution": {
   "text": "the crew begged.",
   "start": 268.883,
   "end": 269.684,
   "first_word": 684,
   "last_word": 686
  },
  "end_with_attribution": 269.684,
  "gap_before": 0.4
 },
 {
  "beat": 50,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P07",
  "text": "Cyclops. If anyone asks who blinded you, tell them it was Odysseus. Son of Laertes. Of Ithaca.",
  "words": 17,
  "first_word": 687,
  "last_word": 703,
  "start": 269.964,
  "end": 278.266,
  "duration": 8.302,
  "gap_before": 0.28
 },
 {
  "beat": 51,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P07",
  "text": "Nobody lasted one night.",
  "words": 4,
  "first_word": 704,
  "last_word": 707,
  "start": 278.586,
  "end": 280.026,
  "duration": 1.44,
  "gap_before": 0.32
 },
 {
  "beat": 52,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P07",
  "text": "A prophet told me Odysseus would take my eye. I expected a warrior. I got a weakling who got me drunk. Come back, and I will give you presents.",
  "words": 29,
  "first_word": 708,
  "last_word": 736,
  "start": 280.346,
  "end": 290.435,
  "duration": 10.089,
  "attribution": {
   "text": "the giant called.",
   "start": 290.877,
   "end": 291.771,
   "first_word": 737,
   "last_word": 739
  },
  "end_with_attribution": 291.771,
  "gap_before": 0.32
 },
 {
  "beat": 53,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P07",
  "text": "Keep your presents. I would send you to Hades if I could. Not even Poseidon will heal that eye.",
  "words": 19,
  "first_word": 740,
  "last_word": 758,
  "start": 292.052,
  "end": 298.135,
  "duration": 6.083,
  "gap_before": 0.281
 },
 {
  "beat": 54,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P07",
  "text": "Father Poseidon, hear me. Never let Odysseus reach his home. Or if he must, let him come late, in misery, and with all his men lost.",
  "words": 26,
  "first_word": 759,
  "last_word": 784,
  "start": 298.415,
  "end": 309.201,
  "duration": 10.786,
  "attribution": {
   "text": "the giant prayed.",
   "start": 309.816,
   "end": 310.78,
   "first_word": 785,
   "last_word": 787
  },
  "end_with_attribution": 310.78,
  "gap_before": 0.28
 },
 {
  "beat": 55,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Poseidon listens. It will be years before Odysseus sees Ithaca again.",
  "words": 11,
  "first_word": 788,
  "last_word": 798,
  "start": 311.13,
  "end": 315.832,
  "duration": 4.702,
  "gap_before": 0.35
 },
 {
  "beat": 56,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Now search Book Nine for the words \"one eye\". Homer never writes them, and he never mentions a forehead. He says \"the eye\".",
  "words": 23,
  "first_word": 799,
  "last_word": 821,
  "start": 316.232,
  "end": 325.009,
  "duration": 8.777,
  "gap_before": 0.4
 },
 {
  "beat": 57,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Homer takes it for granted. If you want it spelled out, you need a different poet. So where did the Cyclops come from?",
  "words": 23,
  "first_word": 822,
  "last_word": 844,
  "start": 325.438,
  "end": 333.054,
  "duration": 7.616,
  "gap_before": 0.429
 },
 {
  "beat": 58,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P08",
  "text": "Time to open the case.",
  "words": 5,
  "first_word": 845,
  "last_word": 849,
  "start": 333.454,
  "end": 335.184,
  "duration": 1.73,
  "gap_before": 0.4
 },
 {
  "beat": 59,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 1: THE DWARF ELEPHANT",
  "start": 335.509,
  "end": 335.509,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 60,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "Ice Age Sicily had elephants, and island life shrank them until the smallest stood under a metre. You could have looked one in the eye.",
  "words": 25,
  "first_word": 850,
  "last_word": 874,
  "start": 335.634,
  "end": 345.317,
  "duration": 9.683,
  "gap_before": 0.45
 },
 {
  "beat": 61,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "Their bones have turned up in caves on Sicily and Malta. Head-on, the skull shows two small eye sockets at the sides, and in the middle, one enormous hole.",
  "words": 29,
  "first_word": 875,
  "last_word": 903,
  "start": 345.717,
  "end": 357.408,
  "duration": 11.691,
  "gap_before": 0.4
 },
 {
  "beat": 62,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "In 1914, a palaeontologist named Abel imagined sailors finding a skull like this in a beach cave. He thought it might be where the Cyclops came from.",
  "words": 27,
  "first_word": 904,
  "last_word": 930,
  "start": 357.808,
  "end": 368.14,
  "duration": 10.332,
  "gap_before": 0.4
 },
 {
  "beat": 63,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "Here is our version. A sailor ducks in to light a fire.",
  "words": 12,
  "first_word": 931,
  "last_word": 942,
  "start": 368.54,
  "end": 373.102,
  "duration": 4.562,
  "gap_before": 0.4
 },
 {
  "beat": 64,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P09",
  "text": "Hello?",
  "words": 1,
  "first_word": 943,
  "last_word": 943,
  "start": 373.422,
  "end": 373.817,
  "duration": 0.395,
  "attribution": {
   "text": "the sailor asked.",
   "start": 374.374,
   "end": 375.187,
   "first_word": 944,
   "last_word": 946
  },
  "end_with_attribution": 375.187,
  "gap_before": 0.32
 },
 {
  "beat": 65,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "In the clay, something looks back at him. One enormous eye.",
  "words": 11,
  "first_word": 947,
  "last_word": 957,
  "start": 375.507,
  "end": 380.255,
  "duration": 4.748,
  "gap_before": 0.32
 },
 {
  "beat": 66,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P09",
  "text": "Nope.",
  "words": 1,
  "first_word": 958,
  "last_word": 958,
  "start": 380.575,
  "end": 381.04,
  "duration": 0.465,
  "gap_before": 0.32
 },
 {
  "beat": 67,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P09",
  "text": "The sailor is imagined. The skulls are real.",
  "words": 8,
  "first_word": 959,
  "last_word": 966,
  "start": 381.36,
  "end": 384.68,
  "duration": 3.32,
  "gap_before": 0.32
 },
 {
  "beat": 68,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P10",
  "text": "Where's the nose?",
  "words": 3,
  "first_word": 967,
  "last_word": 969,
  "start": 385.08,
  "end": 386.183,
  "duration": 1.103,
  "gap_before": 0.4
 },
 {
  "beat": 69,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "You are looking at it. That hole is a nasal cavity. To someone who had never seen an elephant, it could pass for one very large eye.",
  "words": 27,
  "first_word": 970,
  "last_word": 996,
  "start": 386.503,
  "end": 396.638,
  "duration": 10.135,
  "gap_before": 0.32
 },
 {
  "beat": 70,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "Discover magazine adds that before Alexander the Great, most Greeks had never seen a live elephant. A skull could easily have baffled them.",
  "words": 23,
  "first_word": 997,
  "last_word": 1019,
  "start": 397.038,
  "end": 406.292,
  "duration": 9.254,
  "gap_before": 0.4
 },
 {
  "beat": 71,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "The folklorist Adrienne Mayor is the theory's best-known champion. Asked about the Cyclops, she is careful.",
  "words": 16,
  "first_word": 1020,
  "last_word": 1035,
  "start": 406.692,
  "end": 414.598,
  "duration": 7.906,
  "gap_before": 0.4
 },
 {
  "beat": 72,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "\"I don't like to say that the fossils inspired, or were the source of the story, because we just can't prove that.\"",
  "words": 22,
  "first_word": 1036,
  "last_word": 1057,
  "start": 414.998,
  "end": 421.698,
  "duration": 6.7,
  "gap_before": 0.4
 },
 {
  "beat": 73,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P10",
  "text": "That is the theory's best friend, on the record. She does think fossils shaped how Greeks pictured giants. She just won't say they started this one.",
  "words": 26,
  "first_word": 1058,
  "last_word": 1083,
  "start": 422.098,
  "end": 432.036,
  "duration": 9.938,
  "gap_before": 0.4
 },
 {
  "beat": 74,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Then there is the famous version. In Abel's telling, the philosopher Empedocles reported such bones on Sicily and took them for giants.",
  "words": 22,
  "first_word": 1084,
  "last_word": 1105,
  "start": 432.386,
  "end": 442.742,
  "duration": 10.356,
  "gap_before": 0.35
 },
 {
  "beat": 75,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P11",
  "text": "Which ancient book says that?",
  "words": 5,
  "first_word": 1106,
  "last_word": 1110,
  "start": 443.062,
  "end": 444.653,
  "duration": 1.591,
  "attribution": {
   "text": "the sailor asked.",
   "start": 444.92,
   "end": 445.859,
   "first_word": 1111,
   "last_word": 1113
  },
  "end_with_attribution": 445.859,
  "gap_before": 0.32
 },
 {
  "beat": 76,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "None that survives. The translator Jason Colavito calls it \"a modern myth invented, apparently, by Abel himself.\"",
  "words": 17,
  "first_word": 1114,
  "last_word": 1130,
  "start": 446.179,
  "end": 455.061,
  "duration": 8.882,
  "gap_before": 0.32
 },
 {
  "beat": 77,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Without that story, critics say, Abel's case is very thin.",
  "words": 10,
  "first_word": 1131,
  "last_word": 1140,
  "start": 455.461,
  "end": 460.314,
  "duration": 4.853,
  "gap_before": 0.4
 },
 {
  "beat": 78,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Abel hedged his sailors with \"perhaps\". His Empedocles, he told straight.",
  "words": 11,
  "first_word": 1141,
  "last_word": 1151,
  "start": 460.714,
  "end": 465.346,
  "duration": 4.632,
  "gap_before": 0.4
 },
 {
  "beat": 79,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Two scholars of Greek myth, Aguirre and Buxton, have serious doubts about the dwarf-elephant explanation.",
  "words": 15,
  "first_word": 1152,
  "last_word": 1166,
  "start": 465.746,
  "end": 472.898,
  "duration": 7.152,
  "gap_before": 0.4
 },
 {
  "beat": 80,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P11",
  "text": "Possible. Provable? No.",
  "words": 3,
  "first_word": 1167,
  "last_word": 1169,
  "start": 473.598,
  "end": 476.303,
  "duration": 2.705,
  "gap_before": 0.7
 },
 {
  "beat": 81,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 2: THE SMITHS",
  "start": 476.628,
  "end": 476.628,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 82,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "Suspect two lives in a different poem, with a different job.",
  "words": 11,
  "first_word": 1170,
  "last_word": 1180,
  "start": 476.753,
  "end": 480.282,
  "duration": 3.529,
  "gap_before": 0.45
 },
 {
  "beat": 83,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "Hesiod, around seven hundred BC, has three Cyclopes: Thunder, Lightning and Bright.",
  "words": 12,
  "first_word": 1181,
  "last_word": 1192,
  "start": 480.682,
  "end": 486.87,
  "duration": 6.188,
  "gap_before": 0.4
 },
 {
  "beat": 84,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "They make the thunderbolt for Zeus. The Cyclopes of Book Nine shrug Zeus off.",
  "words": 14,
  "first_word": 1193,
  "last_word": 1206,
  "start": 487.27,
  "end": 492.599,
  "duration": 5.329,
  "gap_before": 0.4
 },
 {
  "beat": 85,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P12",
  "text": "I keep sheep.",
  "words": 3,
  "first_word": 1207,
  "last_word": 1209,
  "start": 492.919,
  "end": 493.755,
  "duration": 0.836,
  "attribution": {
   "text": "the giant said awkwardly.",
   "start": 494.068,
   "end": 495.299,
   "first_word": 1210,
   "last_word": 1213
  },
  "end_with_attribution": 495.299,
  "gap_before": 0.32
 },
 {
  "beat": 86,
  "type": "line",
  "spoken": true,
  "speaker": "CYC2",
  "passage": "P12",
  "text": "Sheep.",
  "words": 1,
  "first_word": 1214,
  "last_word": 1214,
  "start": 495.579,
  "end": 496.02,
  "duration": 0.441,
  "gap_before": 0.28
 },
 {
  "beat": 87,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "Hesiod's Cyclopes have careers.",
  "words": 4,
  "first_word": 1215,
  "last_word": 1218,
  "start": 496.34,
  "end": 498.499,
  "duration": 2.159,
  "gap_before": 0.32
 },
 {
  "beat": 88,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "And there it is, the line Book Nine never gave us: one eye only, in the middle of the forehead.",
  "words": 20,
  "first_word": 1219,
  "last_word": 1238,
  "start": 498.899,
  "end": 505.331,
  "duration": 6.432,
  "gap_before": 0.4
 },
 {
  "beat": 89,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P12",
  "text": "The scholar Walter Burkert suggested that real guilds of metalworkers may lie behind them.",
  "words": 14,
  "first_word": 1239,
  "last_word": 1252,
  "start": 505.731,
  "end": 511.641,
  "duration": 5.91,
  "gap_before": 0.4
 },
 {
  "beat": 90,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "By the fifth century BC, the Cyclopes have a Sicilian address, next to Mount Etna. Euripides sets a comic play there.",
  "words": 21,
  "first_word": 1253,
  "last_word": 1273,
  "start": 511.991,
  "end": 521.035,
  "duration": 9.044,
  "gap_before": 0.35
 },
 {
  "beat": 91,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Later, the poet Callimachus sends the smiths to the same neighbourhood, to work for the smith god.",
  "words": 17,
  "first_word": 1274,
  "last_word": 1290,
  "start": 521.435,
  "end": 528.505,
  "duration": 7.07,
  "gap_before": 0.4
 },
 {
  "beat": 92,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Thucydides lists the Cyclopes among the earliest people spoken of in Sicily. Then he admits, \"I cannot tell of what race they were.\"",
  "words": 23,
  "first_word": 1291,
  "last_word": 1313,
  "start": 528.905,
  "end": 538.134,
  "duration": 9.229,
  "gap_before": 0.4
 },
 {
  "beat": 93,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Locals, he records, believed the smith god kept a forge on one of the Aeolian islands. Flame by night. Smoke by day.",
  "words": 22,
  "first_word": 1314,
  "last_word": 1335,
  "start": 538.534,
  "end": 547.323,
  "duration": 8.789,
  "gap_before": 0.4
 },
 {
  "beat": 94,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Forges need fire. Sicily had volcanoes. You can see how the two met.",
  "words": 13,
  "first_word": 1336,
  "last_word": 1348,
  "start": 547.723,
  "end": 552.912,
  "duration": 5.189,
  "gap_before": 0.4
 },
 {
  "beat": 95,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "In the third century BC, Theocritus has Polyphemus sing a love song to a sea nymph. He frets about his looks: one long unbroken eyebrow, and one eye.",
  "words": 28,
  "first_word": 1349,
  "last_word": 1376,
  "start": 553.312,
  "end": 565.004,
  "duration": 11.692,
  "gap_before": 0.4
 },
 {
  "beat": 96,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P13",
  "text": "Plausible. Provable? Also no.",
  "words": 4,
  "first_word": 1377,
  "last_word": 1380,
  "start": 565.704,
  "end": 568.92,
  "duration": 3.216,
  "gap_before": 0.7
 },
 {
  "beat": 97,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 3: THE WALLS",
  "start": 569.245,
  "end": 569.245,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 98,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "Suspect three is not a story. You can go and stand next to it.",
  "words": 14,
  "first_word": 1381,
  "last_word": 1394,
  "start": 569.37,
  "end": 573.027,
  "duration": 3.657,
  "gap_before": 0.45
 },
 {
  "beat": 99,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "At Tiryns and Mycenae, Bronze Age walls rise from boulders so big you wonder who lifted them.",
  "words": 17,
  "first_word": 1395,
  "last_word": 1411,
  "start": 573.427,
  "end": 579.847,
  "duration": 6.42,
  "gap_before": 0.4
 },
 {
  "beat": 100,
  "type": "line",
  "spoken": true,
  "speaker": "CREW",
  "passage": "P14",
  "text": "Who lifted those?",
  "words": 3,
  "first_word": 1412,
  "last_word": 1414,
  "start": 580.167,
  "end": 581.2,
  "duration": 1.033,
  "attribution": {
   "text": "a crewman asked.",
   "start": 581.514,
   "end": 582.326,
   "first_word": 1415,
   "last_word": 1417
  },
  "end_with_attribution": 582.326,
  "gap_before": 0.32
 },
 {
  "beat": 101,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "At Tiryns, the travel writer Pausanias finds stones so big that a pair of mules could not move even the smallest.",
  "words": 21,
  "first_word": 1418,
  "last_word": 1438,
  "start": 582.646,
  "end": 591.087,
  "duration": 8.441,
  "gap_before": 0.32
 },
 {
  "beat": 102,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "He reports that the Cyclopes built that wall, and that Mycenae's wall and Lion Gate are said to be theirs too.",
  "words": 21,
  "first_word": 1439,
  "last_word": 1459,
  "start": 591.487,
  "end": 598.533,
  "duration": 7.046,
  "gap_before": 0.4
 },
 {
  "beat": 103,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "Homer: twenty-two wagons for one door. Pausanias: two mules, and the stone wins. The Greeks measured giants in wagons and mules.",
  "words": 21,
  "first_word": 1460,
  "last_word": 1480,
  "start": 598.933,
  "end": 609.556,
  "duration": 10.623,
  "gap_before": 0.4
 },
 {
  "beat": 104,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "The Lion Gate is about twelve fifty BC. People built it, and later Greeks credited the Cyclopes. Archaeologists still call the style cyclopean masonry.",
  "words": 24,
  "first_word": 1481,
  "last_word": 1504,
  "start": 609.956,
  "end": 620.486,
  "duration": 10.53,
  "gap_before": 0.4
 },
 {
  "beat": 105,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P14",
  "text": "The wall is real. The giants were the Greeks' explanation for it. It cannot tell us where Homer's giant began.",
  "words": 20,
  "first_word": 1505,
  "last_word": 1524,
  "start": 621.186,
  "end": 629.011,
  "duration": 7.825,
  "gap_before": 0.7
 },
 {
  "beat": 106,
  "type": "text-chip",
  "spoken": false,
  "text": "SUSPECT 4: THE FOLKTALE",
  "start": 629.336,
  "end": 629.336,
  "duration": 0.0,
  "words": 0,
  "speaker": "TEXT-CHIP",
  "note": "on-screen only, zero audio duration; `at` is the middle of the passage join"
 },
 {
  "beat": 107,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Suspect four does not need an elephant, a smith, or a wall. It does not even need Sicily.",
  "words": 18,
  "first_word": 1525,
  "last_word": 1542,
  "start": 629.461,
  "end": 636.102,
  "duration": 6.641,
  "gap_before": 0.45
 },
 {
  "beat": 108,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Strip off the names, and you have a story you have already watched. A man is trapped by a giant, blinds him, and gets away.",
  "words": 25,
  "first_word": 1543,
  "last_word": 1567,
  "start": 636.502,
  "end": 645.802,
  "duration": 9.3,
  "gap_before": 0.4
 },
 {
  "beat": 109,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Scholars have recorded more than two hundred versions. Iceland. Portugal. Russia. Even the Arabian Nights.",
  "words": 15,
  "first_word": 1568,
  "last_word": 1582,
  "start": 646.202,
  "end": 654.271,
  "duration": 8.069,
  "gap_before": 0.4
 },
 {
  "beat": 110,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "Most scholars think the tale is older than Homer.",
  "words": 9,
  "first_word": 1583,
  "last_word": 1591,
  "start": 654.671,
  "end": 657.353,
  "duration": 2.682,
  "gap_before": 0.4
 },
 {
  "beat": 111,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P15",
  "text": "So I was not the first.",
  "words": 6,
  "first_word": 1592,
  "last_word": 1597,
  "start": 657.673,
  "end": 659.484,
  "duration": 1.811,
  "attribution": {
   "text": "Odysseus muttered.",
   "start": 659.682,
   "end": 660.587,
   "first_word": 1598,
   "last_word": 1599
  },
  "end_with_attribution": 660.587,
  "gap_before": 0.32
 },
 {
  "beat": 112,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "That does not rule out the skull. It does mean the story does not need one.",
  "words": 16,
  "first_word": 1600,
  "last_word": 1615,
  "start": 660.907,
  "end": 666.074,
  "duration": 5.167,
  "gap_before": 0.32
 },
 {
  "beat": 113,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P15",
  "text": "On that view, Homer did not invent the Cyclops story. He gave us the best-known version.",
  "words": 16,
  "first_word": 1616,
  "last_word": 1631,
  "start": 666.774,
  "end": 672.881,
  "duration": 6.107,
  "gap_before": 0.7
 },
 {
  "beat": 114,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Four suspects. The smiths have Hesiod. The walls have Pausanias. The folktale has two hundred versions. The elephant has real skulls, and an imaginary sailor.",
  "words": 25,
  "first_word": 1632,
  "last_word": 1656,
  "start": 673.231,
  "end": 685.05,
  "duration": 11.819,
  "gap_before": 0.35
 },
 {
  "beat": 115,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "So was the Cyclops real? As a one-eyed giant who eats sailors, no.",
  "words": 13,
  "first_word": 1657,
  "last_word": 1669,
  "start": 685.45,
  "end": 690.222,
  "duration": 4.772,
  "gap_before": 0.4
 },
 {
  "beat": 116,
  "type": "line",
  "spoken": true,
  "speaker": "POLY",
  "passage": "P16",
  "text": "Rude.",
  "words": 1,
  "first_word": 1670,
  "last_word": 1670,
  "start": 690.542,
  "end": 691.123,
  "duration": 0.581,
  "gap_before": 0.32
 },
 {
  "beat": 117,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "But the name is real. It was wrapped around a forge, a wall, a story, and perhaps a skull.",
  "words": 19,
  "first_word": 1671,
  "last_word": 1689,
  "start": 691.443,
  "end": 698.85,
  "duration": 7.407,
  "gap_before": 0.32
 },
 {
  "beat": 118,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Who can prove where the Cyclops came from?",
  "words": 8,
  "first_word": 1690,
  "last_word": 1697,
  "start": 699.25,
  "end": 701.77,
  "duration": 2.52,
  "gap_before": 0.4
 },
 {
  "beat": 119,
  "type": "line",
  "spoken": true,
  "speaker": "ODY",
  "passage": "P16",
  "text": "Nobody.",
  "words": 1,
  "first_word": 1698,
  "last_word": 1698,
  "start": 702.52,
  "end": 703.042,
  "duration": 0.522,
  "gap_before": 0.75
 },
 {
  "beat": 120,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Next time: the wind in the bag, the witch with the wand, and the other monsters of the Odyssey.",
  "words": 19,
  "first_word": 1699,
  "last_word": 1717,
  "start": 703.362,
  "end": 708.75,
  "duration": 5.388,
  "gap_before": 0.32
 },
 {
  "beat": 121,
  "type": "line",
  "spoken": true,
  "speaker": "NARR",
  "passage": "P16",
  "text": "Odysseus thinks the worst is behind him. He has just told a giant his name, and the giant has a father.",
  "words": 21,
  "first_word": 1718,
  "last_word": 1738,
  "start": 709.15,
  "end": 715.941,
  "duration": 6.791,
  "gap_before": 0.4
 }
]