#!/usr/bin/env bash
# V5 animatic. usage: bash render.sh slice scenes/slice1/cuts.json -> out/${SLICE_NAME}_540p.mp4 + out/slice1_sheet.jpg
#        bash render.sh animatic  -> out/animatic_540p.mp4 (+ stills, QA.md)
#        bash render.sh first2min  -> out/FIRST-2MIN.jpg (beats 1-43, render-time frames)
# env: RESUME=1 keeps existing chunks (default 0 clears), FORCE=1 renders despite missing plates, CONC, CHUNK
set -euo pipefail
cd "$(dirname "$0")"
FFMPEG=${FFMPEG:-/home/williamdownard/openclaw-sites/bin/ffmpeg}
NARR=../audio-v5/narration_voice_only.wav
CONC=${CONC:-11}
mkdir -p out
MODE=${1:-animatic}
if [ "${1:-animatic}" = full ]; then
  # bash render.sh full scenes/full/cuts.json -> out/v8_540p.mp4 (+ out/v8_sheet_[abc].jpg, out/v8_stills.jpg via full_sheets.py)
  CUTS=${2:?usage: render.sh full <cuts.json>}
  [ -f "$CUTS" ] || CUTS="../$CUTS"
  export SLICE_NAME=full SLICE_END=568.537 SLICE_TAIL=2.0   # narration end + 1.5 s hold + 0.5 s fade
  node slice.js prep "$CUTS"
  SFR=$(node -p "require('./src/slice_timeline.json').total")
  DUR=$(node -p "($SFR/30).toFixed(3)")
  if [ "${RESUME:-0}" != 1 ] || [ ! -s out/v8_540p_silent_raw.mp4 ]; then
    npx remotion render src/index.ts Slice out/v8_540p_silent_raw.mp4 --scale=0.5 --codec=h264 --crf=20 --muted --concurrency="${CONC:-8}" --log=warn
  fi
  "$FFMPEG" -y -loglevel error -i out/v8_540p_silent_raw.mp4 -vf "fade=t=out:st=$(node -p "($DUR-0.5).toFixed(3)"):d=0.5" -c:v libx264 -crf 20 -pix_fmt yuv420p out/v8_540p_silent.mp4
  "$FFMPEG" -y -loglevel error -i out/v8_540p_silent.mp4 -i "$NARR" -map 0:v -map 1:a -c:v copy -af "apad,afade=t=out:st=$(node -p "($DUR-0.5).toFixed(3)"):d=0.5" -t "$DUR" -c:a aac -b:a 160k -movflags +faststart out/v8_540p.mp4
  echo "wrote out/v8_540p.mp4 (${DUR}s)"
  ~/.venvs/refwatch/bin/python full_sheets.py
  exit 0
fi
if [ "${1:-animatic}" = slice ]; then
  # bash render.sh slice scenes/slice1/cuts.json -> out/${SLICE_NAME}_540p.mp4 (+ out/slice1_sheet.jpg); does not touch the animatic timeline/plates
  CUTS=${2:?usage: render.sh slice <cuts.json>}
  [ -f "$CUTS" ] || CUTS="../$CUTS"   # accept a path relative to video2/
  export SLICE_NAME=$(basename "$(dirname "$(realpath "$CUTS")")")
  node slice.js prep "$CUTS"
  SFR=$(node -p "require('./src/slice_timeline.json').total")
  npx remotion render src/index.ts Slice out/${SLICE_NAME}_540p_silent.mp4 --scale=0.5 --codec=h264 --crf=20 --muted --concurrency="${CONC:-8}" --log=warn
  "$FFMPEG" -y -loglevel error -i out/${SLICE_NAME}_540p_silent.mp4 -i "$NARR" -map 0:v -map 1:a -c:v copy -af "atrim=end=154.1,apad" -t "$(node -p "($SFR/30).toFixed(3)")" -c:a aac -b:a 160k -movflags +faststart out/${SLICE_NAME}_540p.mp4
  echo "wrote out/${SLICE_NAME}_540p.mp4"
  node slice.js sheet
  exit 0
fi
node resolve.js            # re-reads plates-v5/img at render time
NMISS=$(node -p "require('./src/timeline.json').missing.length")
if [ "$MODE" = first2min ]; then node first2min.js; exit $?; fi
[ "$MODE" = animatic ] || { echo "usage: render.sh animatic|first2min" >&2; exit 64; }
if [ "$NMISS" -gt 0 ] && [ "${FORCE:-0}" != 1 ]; then
  echo "missing plates ($NMISS): $(node -p "require('./src/timeline.json').missing.join(' ')")" >&2
  echo "refusing to render; set FORCE=1 to render with placeholders" >&2; exit 2
fi
if [ "${RESUME:-0}" != 1 ]; then rm -f out/chunk_*.mp4 out/chunks.txt out/render_*.log; fi
SILENT=out/animatic_v6_540p_silent.mp4; OUT=out/animatic_v6_540p.mp4
date +%s > out/render.start
TOTAL=$(node -p "require('./src/timeline.json').total")
CH=${CHUNK:-4300}; : > out/chunks.txt; i=0
for ((s=0; s<TOTAL; s+=CH)); do
  e=$((s+CH-1)); [ $e -ge $TOTAL ] && e=$((TOTAL-1))
  P=out/chunk_$i.mp4
  if [ "${RESUME:-0}" = 1 ] && [ -s "$P" ]; then :; else
  npx remotion render src/index.ts BluePill "$P" --frames=$s-$e --scale=0.5 --codec=h264 --crf=20 --muted --concurrency="$CONC" --log=warn > out/render_$i.log 2>&1
  fi
  echo "file 'chunk_$i.mp4'" >> out/chunks.txt; i=$((i+1))
done
"$FFMPEG" -y -loglevel error -f concat -safe 0 -i out/chunks.txt -c copy "$SILENT"
date +%s > out/render.end
"$FFMPEG" -y -loglevel error -i "$SILENT" -i "$NARR" -map 0:v -map 1:a -c:v copy -af apad -t "$(node -p "(require('./src/timeline.json').total/30).toFixed(3)")" -c:a aac -b:a 192k -movflags +faststart "$OUT"
echo "wrote $OUT"
node stills.js
