[
 {
  "beat": 0,
  "chapter": 0,
  "text": "Hundreds of thousands of years ago, an elephant lived on Sicily.",
  "words": 11,
  "start": 0.4,
  "end": 4.185,
  "duration": 3.785,
  "first_word": 0,
  "last_word": 10,
  "new_paragraph": true
 },
 {
  "beat": 1,
  "chapter": 0,
  "text": "It stood less than a metre tall at the shoulder.",
  "words": 10,
  "start": 4.498,
  "end": 7.111,
  "duration": 2.613,
  "first_word": 11,
  "last_word": 20,
  "new_paragraph": false
 },
 {
  "beat": 2,
  "chapter": 0,
  "text": "Its skull has one enormous hole in the middle of its face.",
  "words": 12,
  "start": 7.598,
  "end": 11.012,
  "duration": 3.414,
  "first_word": 21,
  "last_word": 32,
  "new_paragraph": false
 },
 {
  "beat": 3,
  "chapter": 0,
  "text": "In 1914, a palaeontologist argued that hole is where the Cyclops came from.",
  "words": 13,
  "start": 11.499,
  "end": 16.84,
  "duration": 5.341,
  "first_word": 33,
  "last_word": 45,
  "new_paragraph": false
 },
 {
  "beat": 4,
  "chapter": 0,
  "text": "The idea is now everywhere. Today, we check what is under it.",
  "words": 12,
  "start": 17.327,
  "end": 21.948,
  "duration": 4.621,
  "first_word": 46,
  "last_word": 57,
  "new_paragraph": false
 },
 {
  "beat": 5,
  "chapter": 1,
  "text": "If it is right, one of literature's most famous monsters began as an honest mistake.",
  "words": 15,
  "start": 22.348,
  "end": 27.631,
  "duration": 5.283,
  "first_word": 58,
  "last_word": 72,
  "new_paragraph": true
 },
 {
  "beat": 6,
  "chapter": 1,
  "text": "If it is wrong, we have been passing on a good story with nothing underneath.",
  "words": 15,
  "start": 28.118,
  "end": 32.228,
  "duration": 4.11,
  "first_word": 73,
  "last_word": 87,
  "new_paragraph": false
 },
 {
  "beat": 7,
  "chapter": 1,
  "text": "So we will go slowly: the poem first, then the bones, then the people who disagree.",
  "words": 16,
  "start": 32.797,
  "end": 39.67,
  "duration": 6.873,
  "first_word": 88,
  "last_word": 103,
  "new_paragraph": false
 },
 {
  "beat": 8,
  "chapter": 2,
  "text": "Homer tells it in Book Nine of the Odyssey, and he lets Odysseus tell it himself.",
  "words": 16,
  "start": 41.67,
  "end": 46.569,
  "duration": 4.899,
  "first_word": 104,
  "last_word": 119,
  "new_paragraph": true
 },
 {
  "beat": 9,
  "chapter": 2,
  "text": "So this is the hero's own account.",
  "words": 7,
  "start": 47.057,
  "end": 49.054,
  "duration": 1.997,
  "first_word": 120,
  "last_word": 126,
  "new_paragraph": false
 },
 {
  "beat": 10,
  "chapter": 2,
  "text": "They reach the land of the Cyclopes, a place Homer never locates.",
  "words": 12,
  "start": 49.286,
  "end": 53.489,
  "duration": 4.203,
  "first_word": 127,
  "last_word": 138,
  "new_paragraph": false
 },
 {
  "beat": 11,
  "chapter": 2,
  "text": "On a cliff stands a cave, full of sheep and goats. Odysseus takes twelve men to look.",
  "words": 17,
  "start": 53.977,
  "end": 60.258,
  "duration": 6.281,
  "first_word": 139,
  "last_word": 155,
  "new_paragraph": false
 },
 {
  "beat": 12,
  "chapter": 2,
  "text": "The owner is out.",
  "words": 4,
  "start": 60.688,
  "end": 61.93,
  "duration": 1.242,
  "first_word": 156,
  "last_word": 159,
  "new_paragraph": false
 },
 {
  "beat": 13,
  "chapter": 2,
  "text": "His men find racks of cheese, and suggest taking some and leaving.",
  "words": 12,
  "start": 62.127,
  "end": 66.609,
  "duration": 4.482,
  "first_word": 160,
  "last_word": 171,
  "new_paragraph": false
 },
 {
  "beat": 14,
  "chapter": 2,
  "text": "Odysseus refuses. He wants to meet the owner, in case there is a gift.",
  "words": 14,
  "start": 67.096,
  "end": 71.52,
  "duration": 4.424,
  "first_word": 172,
  "last_word": 185,
  "new_paragraph": false
 },
 {
  "beat": 15,
  "chapter": 2,
  "text": "The owner is Polyphemus. Homer says he looks less like a man who eats bread,",
  "words": 15,
  "start": 72.008,
  "end": 76.872,
  "duration": 4.864,
  "first_word": 186,
  "last_word": 200,
  "new_paragraph": false
 },
 {
  "beat": 16,
  "chapter": 2,
  "text": "than like a wooded peak, standing alone above the others.",
  "words": 10,
  "start": 77.035,
  "end": 80.436,
  "duration": 3.401,
  "first_word": 201,
  "last_word": 210,
  "new_paragraph": false
 },
 {
  "beat": 17,
  "chapter": 2,
  "text": "He drives his flock inside, and rolls a stone across the entrance.",
  "words": 12,
  "start": 80.924,
  "end": 85.185,
  "duration": 4.261,
  "first_word": 211,
  "last_word": 222,
  "new_paragraph": false
 },
 {
  "beat": 18,
  "chapter": 2,
  "text": "Homer says twenty-two four-wheeled wagons could not have moved it.",
  "words": 10,
  "start": 85.673,
  "end": 89.608,
  "duration": 3.935,
  "first_word": 223,
  "last_word": 232,
  "new_paragraph": false
 },
 {
  "beat": 19,
  "chapter": 2,
  "text": "That stone is the real trap. Odysseus thinks of drawing his sword,",
  "words": 12,
  "start": 90.037,
  "end": 94.531,
  "duration": 4.494,
  "first_word": 233,
  "last_word": 244,
  "new_paragraph": false
 },
 {
  "beat": 20,
  "chapter": 2,
  "text": "then realises that if he kills the giant, no one can ever open the door.",
  "words": 15,
  "start": 94.763,
  "end": 99.476,
  "duration": 4.713,
  "first_word": 245,
  "last_word": 259,
  "new_paragraph": false
 },
 {
  "beat": 21,
  "chapter": 2,
  "text": "So he waits. Across three meals, Polyphemus eats six of his men, two at a time.",
  "words": 16,
  "start": 99.964,
  "end": 106.512,
  "duration": 6.548,
  "first_word": 260,
  "last_word": 275,
  "new_paragraph": false
 },
 {
  "beat": 22,
  "chapter": 2,
  "text": "Homer gives the detail. We will leave it out.",
  "words": 9,
  "start": 106.872,
  "end": 110.03,
  "duration": 3.158,
  "first_word": 276,
  "last_word": 284,
  "new_paragraph": false
 },
 {
  "beat": 23,
  "chapter": 2,
  "text": "He finds the giant's own club, a green olive trunk the size of a ship's mast.",
  "words": 16,
  "start": 110.38,
  "end": 115.523,
  "duration": 5.143,
  "first_word": 285,
  "last_word": 300,
  "new_paragraph": true
 },
 {
  "beat": 24,
  "chapter": 2,
  "text": "He cuts off a length, sharpens it, and hardens the point in the fire.",
  "words": 14,
  "start": 116.011,
  "end": 120.423,
  "duration": 4.412,
  "first_word": 301,
  "last_word": 314,
  "new_paragraph": false
 },
 {
  "beat": 25,
  "chapter": 2,
  "text": "Then he offers Polyphemus wine, a gift from a priest of Apollo.",
  "words": 12,
  "start": 120.91,
  "end": 125.148,
  "duration": 4.238,
  "first_word": 315,
  "last_word": 326,
  "new_paragraph": false
 },
 {
  "beat": 26,
  "chapter": 2,
  "text": "It is so strong that its owners mixed it with twenty measures of water.",
  "words": 14,
  "start": 125.636,
  "end": 129.781,
  "duration": 4.145,
  "first_word": 327,
  "last_word": 340,
  "new_paragraph": false
 },
 {
  "beat": 27,
  "chapter": 2,
  "text": "The giant drinks three bowls, and asks for a name, promising a present.",
  "words": 13,
  "start": 130.268,
  "end": 135.017,
  "duration": 4.749,
  "first_word": 341,
  "last_word": 353,
  "new_paragraph": false
 },
 {
  "beat": 28,
  "chapter": 2,
  "text": "Odysseus says his name is Nobody. The present is that Polyphemus will eat him last.",
  "words": 15,
  "start": 135.504,
  "end": 141.252,
  "duration": 5.748,
  "first_word": 354,
  "last_word": 368,
  "new_paragraph": false
 },
 {
  "beat": 29,
  "chapter": 2,
  "text": "It is not much of a gift, but it buys time.",
  "words": 11,
  "start": 141.612,
  "end": 145.118,
  "duration": 3.506,
  "first_word": 369,
  "last_word": 379,
  "new_paragraph": false
 },
 {
  "beat": 30,
  "chapter": 2,
  "text": "Now the stake goes into the eye. And here is something people rarely notice.",
  "words": 14,
  "start": 145.467,
  "end": 150.552,
  "duration": 5.085,
  "first_word": 380,
  "last_word": 393,
  "new_paragraph": true
 },
 {
  "beat": 31,
  "chapter": 2,
  "text": "Search the whole of Book Nine, and Homer never writes the words 'one eye'.",
  "words": 14,
  "start": 151.121,
  "end": 155.394,
  "duration": 4.273,
  "first_word": 394,
  "last_word": 407,
  "new_paragraph": false
 },
 {
  "beat": 32,
  "chapter": 2,
  "text": "He never mentions a forehead. He says 'the eye', and presumably his audience knew.",
  "words": 14,
  "start": 155.881,
  "end": 161.059,
  "duration": 5.178,
  "first_word": 408,
  "last_word": 421,
  "new_paragraph": false
 },
 {
  "beat": 33,
  "chapter": 2,
  "text": "For a plain statement, one eye in the forehead, we need a different poet.",
  "words": 14,
  "start": 161.547,
  "end": 166.144,
  "duration": 4.597,
  "first_word": 422,
  "last_word": 435,
  "new_paragraph": false
 },
 {
  "beat": 34,
  "chapter": 2,
  "text": "As for the blinding itself, Homer compares it to a shipwright boring a plank,",
  "words": 14,
  "start": 166.818,
  "end": 171.787,
  "duration": 4.969,
  "first_word": 436,
  "last_word": 449,
  "new_paragraph": false
 },
 {
  "beat": 35,
  "chapter": 2,
  "text": "and to a smith quenching an axe in water. That is all we need.",
  "words": 14,
  "start": 172.019,
  "end": 176.907,
  "duration": 4.888,
  "first_word": 450,
  "last_word": 463,
  "new_paragraph": false
 },
 {
  "beat": 36,
  "chapter": 2,
  "text": "The other Cyclopes hear the screaming and come to ask what is wrong.",
  "words": 13,
  "start": 177.581,
  "end": 181.911,
  "duration": 4.33,
  "first_word": 464,
  "last_word": 476,
  "new_paragraph": false
 },
 {
  "beat": 37,
  "chapter": 2,
  "text": "Polyphemus shouts that Nobody is killing him. The others conclude that nobody is.",
  "words": 13,
  "start": 182.341,
  "end": 188.076,
  "duration": 5.735,
  "first_word": 477,
  "last_word": 489,
  "new_paragraph": false
 },
 {
  "beat": 38,
  "chapter": 2,
  "text": "They suggest he pray to Poseidon, and go back to bed.",
  "words": 11,
  "start": 188.564,
  "end": 192.975,
  "duration": 4.411,
  "first_word": 490,
  "last_word": 500,
  "new_paragraph": false
 },
 {
  "beat": 39,
  "chapter": 2,
  "text": "At dawn, the sheep leave the cave. Odysseus has tied them in threes,",
  "words": 13,
  "start": 193.325,
  "end": 197.772,
  "duration": 4.447,
  "first_word": 501,
  "last_word": 513,
  "new_paragraph": true
 },
 {
  "beat": 40,
  "chapter": 2,
  "text": "with a man hidden under each middle sheep. He himself hangs beneath the finest ram.",
  "words": 15,
  "start": 197.83,
  "end": 203.298,
  "duration": 5.468,
  "first_word": 514,
  "last_word": 528,
  "new_paragraph": false
 },
 {
  "beat": 41,
  "chapter": 2,
  "text": "The blinded giant feels along their backs, never their bellies.",
  "words": 10,
  "start": 203.751,
  "end": 207.582,
  "duration": 3.831,
  "first_word": 529,
  "last_word": 538,
  "new_paragraph": false
 },
 {
  "beat": 42,
  "chapter": 2,
  "text": "Homer even lets Polyphemus talk to his ram, almost tenderly, as it leaves last.",
  "words": 14,
  "start": 208.105,
  "end": 213.132,
  "duration": 5.027,
  "first_word": 539,
  "last_word": 552,
  "new_paragraph": false
 },
 {
  "beat": 43,
  "chapter": 2,
  "text": "Then Odysseus, safely aboard his ship, cannot resist.",
  "words": 8,
  "start": 213.654,
  "end": 217.126,
  "duration": 3.472,
  "first_word": 553,
  "last_word": 560,
  "new_paragraph": false
 },
 {
  "beat": 44,
  "chapter": 2,
  "text": "His crew begs him to stop. He shouts his real name anyway.",
  "words": 12,
  "start": 217.52,
  "end": 221.236,
  "duration": 3.716,
  "first_word": 561,
  "last_word": 572,
  "new_paragraph": false
 },
 {
  "beat": 45,
  "chapter": 2,
  "text": "Polyphemus remembers a prophecy that a man named Odysseus would take his sight.",
  "words": 13,
  "start": 221.863,
  "end": 226.159,
  "duration": 4.296,
  "first_word": 573,
  "last_word": 585,
  "new_paragraph": false
 },
 {
  "beat": 46,
  "chapter": 2,
  "text": "He tears the top off a hill and hurls it at the ship,",
  "words": 13,
  "start": 226.681,
  "end": 229.688,
  "duration": 3.007,
  "first_word": 586,
  "last_word": 598,
  "new_paragraph": false
 },
 {
  "beat": 47,
  "chapter": 2,
  "text": "and prays to Poseidon that Odysseus never reaches home.",
  "words": 9,
  "start": 229.978,
  "end": 233.206,
  "duration": 3.228,
  "first_word": 599,
  "last_word": 607,
  "new_paragraph": false
 },
 {
  "beat": 48,
  "chapter": 2,
  "text": "Poseidon listens. For much of the rest of the poem, he keeps Odysseus from home.",
  "words": 15,
  "start": 233.833,
  "end": 239.023,
  "duration": 5.19,
  "first_word": 608,
  "last_word": 622,
  "new_paragraph": false
 },
 {
  "beat": 49,
  "chapter": 3,
  "text": "So that is the myth. Is there anything solid underneath it?",
  "words": 11,
  "start": 241.022,
  "end": 244.493,
  "duration": 3.471,
  "first_word": 623,
  "last_word": 633,
  "new_paragraph": true
 },
 {
  "beat": 50,
  "chapter": 3,
  "text": "In 1914, the palaeontologist Othenio Abel thought there might be.",
  "words": 10,
  "start": 245.19,
  "end": 249.695,
  "duration": 4.505,
  "first_word": 634,
  "last_word": 643,
  "new_paragraph": false
 },
 {
  "beat": 51,
  "chapter": 3,
  "text": "During the Ice Age, dwarf elephants lived on islands across the Mediterranean:",
  "words": 12,
  "start": 250.136,
  "end": 254.548,
  "duration": 4.412,
  "first_word": 644,
  "last_word": 655,
  "new_paragraph": false
 },
 {
  "beat": 52,
  "chapter": 3,
  "text": "Sicily, Malta, Crete, Cyprus, and a scattering of Aegean islands.",
  "words": 10,
  "start": 254.989,
  "end": 259.784,
  "duration": 4.795,
  "first_word": 656,
  "last_word": 665,
  "new_paragraph": false
 },
 {
  "beat": 53,
  "chapter": 3,
  "text": "They descended from a straight-tusked elephant about four metres tall,",
  "words": 10,
  "start": 260.225,
  "end": 263.917,
  "duration": 3.692,
  "first_word": 666,
  "last_word": 675,
  "new_paragraph": false
 },
 {
  "beat": 54,
  "chapter": 3,
  "text": "and island life shrank them.",
  "words": 5,
  "start": 264.091,
  "end": 265.6,
  "duration": 1.509,
  "first_word": 676,
  "last_word": 680,
  "new_paragraph": false
 },
 {
  "beat": 55,
  "chapter": 3,
  "text": "Their bones turn up in caves, and still do.",
  "words": 9,
  "start": 266.041,
  "end": 268.712,
  "duration": 2.671,
  "first_word": 681,
  "last_word": 689,
  "new_paragraph": false
 },
 {
  "beat": 56,
  "chapter": 3,
  "text": "Now look at the skull from the front.",
  "words": 8,
  "start": 269.153,
  "end": 270.918,
  "duration": 1.765,
  "first_word": 690,
  "last_word": 697,
  "new_paragraph": false
 },
 {
  "beat": 57,
  "chapter": 3,
  "text": "The eye sockets are small, and set low at the sides.",
  "words": 11,
  "start": 271.359,
  "end": 274.215,
  "duration": 2.856,
  "first_word": 698,
  "last_word": 708,
  "new_paragraph": false
 },
 {
  "beat": 58,
  "chapter": 3,
  "text": "What dominates is a huge hole in the middle: the opening for the trunk.",
  "words": 14,
  "start": 274.598,
  "end": 278.383,
  "duration": 3.785,
  "first_word": 709,
  "last_word": 722,
  "new_paragraph": false
 },
 {
  "beat": 59,
  "chapter": 3,
  "text": "Abel pictured a sailor, sheltering in a cave and lighting a fire,",
  "words": 12,
  "start": 279.08,
  "end": 282.702,
  "duration": 3.622,
  "first_word": 723,
  "last_word": 734,
  "new_paragraph": false
 },
 {
  "beat": 60,
  "chapter": 3,
  "text": "who sees a skull sticking out of the clay, with one great eye.",
  "words": 13,
  "start": 282.819,
  "end": 286.418,
  "duration": 3.599,
  "first_word": 735,
  "last_word": 747,
  "new_paragraph": false
 },
 {
  "beat": 61,
  "chapter": 3,
  "text": "Everything else, he wrote, was added later. It is imagination, not evidence.",
  "words": 12,
  "start": 286.928,
  "end": 292.014,
  "duration": 5.086,
  "first_word": 748,
  "last_word": 759,
  "new_paragraph": false
 },
 {
  "beat": 62,
  "chapter": 3,
  "text": "The idea found a champion in Adrienne Mayor, a Stanford folklorist and historian of science.",
  "words": 15,
  "start": 292.363,
  "end": 298.168,
  "duration": 5.805,
  "first_word": 760,
  "last_word": 774,
  "new_paragraph": true
 },
 {
  "beat": 63,
  "chapter": 3,
  "text": "In The First Fossil Hunters, she argues that Greeks and Romans noticed big fossil bones,",
  "words": 15,
  "start": 298.632,
  "end": 304.066,
  "duration": 5.434,
  "first_word": 775,
  "last_word": 789,
  "new_paragraph": false
 },
 {
  "beat": 64,
  "chapter": 3,
  "text": "collected them, measured them, and tried to explain them.",
  "words": 9,
  "start": 304.414,
  "end": 307.456,
  "duration": 3.042,
  "first_word": 790,
  "last_word": 798,
  "new_paragraph": false
 },
 {
  "beat": 65,
  "chapter": 3,
  "text": "Giants, and one-eyed monsters, may owe something to those finds.",
  "words": 10,
  "start": 308.095,
  "end": 312.17,
  "duration": 4.075,
  "first_word": 799,
  "last_word": 808,
  "new_paragraph": false
 },
 {
  "beat": 66,
  "chapter": 3,
  "text": "On the Cyclops, though, Mayor herself is careful.",
  "words": 8,
  "start": 312.808,
  "end": 315.897,
  "duration": 3.089,
  "first_word": 809,
  "last_word": 816,
  "new_paragraph": false
 },
 {
  "beat": 67,
  "chapter": 3,
  "text": "She does not like to say the fossils were the source of the story,",
  "words": 14,
  "start": 316.152,
  "end": 319.345,
  "duration": 3.193,
  "first_word": 817,
  "last_word": 830,
  "new_paragraph": false
 },
 {
  "beat": 68,
  "chapter": 3,
  "text": "'because we just can't prove that.' We do not know, she says, which came first.",
  "words": 15,
  "start": 319.809,
  "end": 324.802,
  "duration": 4.993,
  "first_word": 831,
  "last_word": 845,
  "new_paragraph": false
 },
 {
  "beat": 69,
  "chapter": 3,
  "text": "Perhaps the myth came first, and the bones merely seemed to confirm it.",
  "words": 13,
  "start": 325.347,
  "end": 329.701,
  "duration": 4.354,
  "first_word": 846,
  "last_word": 858,
  "new_paragraph": false
 },
 {
  "beat": 70,
  "chapter": 3,
  "text": "Then there is a problem with the most famous version of this theory.",
  "words": 13,
  "start": 330.05,
  "end": 333.196,
  "duration": 3.146,
  "first_word": 859,
  "last_word": 871,
  "new_paragraph": true
 },
 {
  "beat": 71,
  "chapter": 3,
  "text": "Abel claimed that the philosopher Empedocles reported finding such bones on Sicily.",
  "words": 12,
  "start": 333.614,
  "end": 338.723,
  "duration": 5.109,
  "first_word": 872,
  "last_word": 883,
  "new_paragraph": false
 },
 {
  "beat": 72,
  "chapter": 3,
  "text": "Later researchers have found no surviving ancient source that says so.",
  "words": 11,
  "start": 339.21,
  "end": 343.019,
  "duration": 3.809,
  "first_word": 884,
  "last_word": 894,
  "new_paragraph": false
 },
 {
  "beat": 73,
  "chapter": 3,
  "text": "The palaeontologist Mark Witton and Richard Hing put it bluntly:",
  "words": 10,
  "start": 343.437,
  "end": 347.012,
  "duration": 3.575,
  "first_word": 895,
  "last_word": 904,
  "new_paragraph": false
 },
 {
  "beat": 74,
  "chapter": 3,
  "text": "without that story, they argue, the idea becomes baseless.",
  "words": 9,
  "start": 347.43,
  "end": 350.983,
  "duration": 3.553,
  "first_word": 905,
  "last_word": 913,
  "new_paragraph": false
 },
 {
  "beat": 75,
  "chapter": 3,
  "text": "Elephant fossils and one-eyed monsters turn up all over the world,",
  "words": 11,
  "start": 351.645,
  "end": 355.534,
  "duration": 3.889,
  "first_word": 914,
  "last_word": 924,
  "new_paragraph": false
 },
 {
  "beat": 76,
  "chapter": 3,
  "text": "and no ancient text or artwork makes the Sicilian link stand out.",
  "words": 12,
  "start": 355.696,
  "end": 360.236,
  "duration": 4.54,
  "first_word": 925,
  "last_word": 936,
  "new_paragraph": false
 },
 {
  "beat": 77,
  "chapter": 3,
  "text": "The scholars of Greek myth Mercedes Aguirre and Richard Buxton make a similar point.",
  "words": 14,
  "start": 360.723,
  "end": 365.971,
  "duration": 5.248,
  "first_word": 937,
  "last_word": 950,
  "new_paragraph": false
 },
 {
  "beat": 78,
  "chapter": 3,
  "text": "Theories like this sound plausible, they say,",
  "words": 7,
  "start": 366.389,
  "end": 368.955,
  "duration": 2.566,
  "first_word": 951,
  "last_word": 957,
  "new_paragraph": false
 },
 {
  "beat": 79,
  "chapter": 3,
  "text": "but lack a chain of argument linking origin to myth.",
  "words": 10,
  "start": 369.094,
  "end": 372.682,
  "duration": 3.588,
  "first_word": 958,
  "last_word": 967,
  "new_paragraph": false
 },
 {
  "beat": 80,
  "chapter": 4,
  "text": "Meanwhile, the Cyclops had a different life in a different poem.",
  "words": 11,
  "start": 374.682,
  "end": 377.817,
  "duration": 3.135,
  "first_word": 968,
  "last_word": 978,
  "new_paragraph": true
 },
 {
  "beat": 81,
  "chapter": 4,
  "text": "Hesiod, writing around 700 BC, names three Cyclopes: Brontes, Steropes, and Arges.",
  "words": 12,
  "start": 378.235,
  "end": 385.7,
  "duration": 7.465,
  "first_word": 979,
  "last_word": 990,
  "new_paragraph": false
 },
 {
  "beat": 82,
  "chapter": 4,
  "text": "Thunder, Lightning, and Bright. They forge the thunderbolt for Zeus.",
  "words": 10,
  "start": 386.118,
  "end": 390.332,
  "duration": 4.214,
  "first_word": 991,
  "last_word": 1000,
  "new_paragraph": false
 },
 {
  "beat": 83,
  "chapter": 4,
  "text": "And Hesiod is the one who says it plainly:",
  "words": 9,
  "start": 390.495,
  "end": 392.724,
  "duration": 2.229,
  "first_word": 1001,
  "last_word": 1009,
  "new_paragraph": false
 },
 {
  "beat": 84,
  "chapter": 4,
  "text": "'one eye only was set in the midst of their foreheads.'",
  "words": 11,
  "start": 392.886,
  "end": 395.847,
  "duration": 2.961,
  "first_word": 1010,
  "last_word": 1020,
  "new_paragraph": false
 },
 {
  "beat": 85,
  "chapter": 4,
  "text": "These are not cannibal shepherds. They are craftsmen, working for the king of the gods.",
  "words": 15,
  "start": 396.416,
  "end": 400.979,
  "duration": 4.563,
  "first_word": 1021,
  "last_word": 1035,
  "new_paragraph": false
 },
 {
  "beat": 86,
  "chapter": 4,
  "text": "Same name, same eye, completely different job.",
  "words": 7,
  "start": 401.467,
  "end": 404.439,
  "duration": 2.972,
  "first_word": 1036,
  "last_word": 1042,
  "new_paragraph": false
 },
 {
  "beat": 87,
  "chapter": 4,
  "text": "The scholar Walter Burkert suggested the smith Cyclopes may reflect real guilds of metalworkers.",
  "words": 14,
  "start": 404.671,
  "end": 410.488,
  "duration": 5.817,
  "first_word": 1043,
  "last_word": 1056,
  "new_paragraph": false
 },
 {
  "beat": 88,
  "chapter": 4,
  "text": "Later poets merged the two. Virgil puts Brontes and Steropes in a forge under Etna.",
  "words": 15,
  "start": 410.975,
  "end": 416.989,
  "duration": 6.014,
  "first_word": 1057,
  "last_word": 1071,
  "new_paragraph": false
 },
 {
  "beat": 89,
  "chapter": 4,
  "text": "By the fifth century BC, the Cyclopes are living on Sicily.",
  "words": 11,
  "start": 417.558,
  "end": 420.96,
  "duration": 3.402,
  "first_word": 1072,
  "last_word": 1082,
  "new_paragraph": false
 },
 {
  "beat": 90,
  "chapter": 4,
  "text": "Euripides sets a comic satyr play about Polyphemus beside Mount Etna.",
  "words": 11,
  "start": 421.378,
  "end": 425.592,
  "duration": 4.214,
  "first_word": 1083,
  "last_word": 1093,
  "new_paragraph": false
 },
 {
  "beat": 91,
  "chapter": 4,
  "text": "The historian Thucydides lists the Cyclopes among Sicily's earliest inhabitants,",
  "words": 10,
  "start": 426.01,
  "end": 431.107,
  "duration": 5.097,
  "first_word": 1094,
  "last_word": 1103,
  "new_paragraph": false
 },
 {
  "beat": 92,
  "chapter": 4,
  "text": "then adds that he cannot say what race they were, or where they came from.",
  "words": 15,
  "start": 431.467,
  "end": 435.38,
  "duration": 3.913,
  "first_word": 1104,
  "last_word": 1118,
  "new_paragraph": false
 },
 {
  "beat": 93,
  "chapter": 4,
  "text": "He also reports that locals believed the smith-god had a forge",
  "words": 11,
  "start": 435.867,
  "end": 439.188,
  "duration": 3.321,
  "first_word": 1119,
  "last_word": 1129,
  "new_paragraph": false
 },
 {
  "beat": 94,
  "chapter": 4,
  "text": "in the Aeolian islands, judging by the flame at night and the smoke by day.",
  "words": 15,
  "start": 439.223,
  "end": 443.751,
  "duration": 4.528,
  "first_word": 1130,
  "last_word": 1144,
  "new_paragraph": false
 },
 {
  "beat": 95,
  "chapter": 4,
  "text": "By the third century BC, Theocritus has Polyphemus singing love songs to a sea nymph,",
  "words": 15,
  "start": 444.238,
  "end": 449.579,
  "duration": 5.341,
  "first_word": 1145,
  "last_word": 1159,
  "new_paragraph": false
 },
 {
  "beat": 96,
  "chapter": 4,
  "text": "and worrying about his one long eyebrow. Even cannibals get a love life.",
  "words": 13,
  "start": 449.741,
  "end": 454.606,
  "duration": 4.865,
  "first_word": 1160,
  "last_word": 1172,
  "new_paragraph": false
 },
 {
  "beat": 97,
  "chapter": 4,
  "text": "There is a third strand, and it is real in a way the others are not.",
  "words": 16,
  "start": 454.955,
  "end": 458.659,
  "duration": 3.704,
  "first_word": 1173,
  "last_word": 1188,
  "new_paragraph": true
 },
 {
  "beat": 98,
  "chapter": 4,
  "text": "Visit Mycenae or Tiryns, and you can walk beside walls of enormous unworked stones.",
  "words": 14,
  "start": 459.367,
  "end": 464.8,
  "duration": 5.433,
  "first_word": 1189,
  "last_word": 1202,
  "new_paragraph": false
 },
 {
  "beat": 99,
  "chapter": 4,
  "text": "Beside them, even a hero looks small.",
  "words": 7,
  "start": 465.241,
  "end": 467.691,
  "duration": 2.45,
  "first_word": 1203,
  "last_word": 1209,
  "new_paragraph": false
 },
 {
  "beat": 100,
  "chapter": 4,
  "text": "Pausanias, writing in the second century AD, says the walls of Tiryns are the work of the Cyclopes,",
  "words": 18,
  "start": 468.202,
  "end": 474.924,
  "duration": 6.722,
  "first_word": 1210,
  "last_word": 1227,
  "new_paragraph": false
 },
 {
  "beat": 101,
  "chapter": 4,
  "text": "with stones so big that a pair of mules could not move the smallest.",
  "words": 14,
  "start": 475.249,
  "end": 478.999,
  "duration": 3.75,
  "first_word": 1228,
  "last_word": 1241,
  "new_paragraph": false
 },
 {
  "beat": 102,
  "chapter": 4,
  "text": "The walls date to the Bronze Age, centuries before Homer, and people built them.",
  "words": 14,
  "start": 479.441,
  "end": 484.038,
  "duration": 4.597,
  "first_word": 1242,
  "last_word": 1255,
  "new_paragraph": false
 },
 {
  "beat": 103,
  "chapter": 4,
  "text": "Archaeologists still call the style cyclopean masonry.",
  "words": 7,
  "start": 484.862,
  "end": 488.461,
  "duration": 3.599,
  "first_word": 1256,
  "last_word": 1262,
  "new_paragraph": false
 },
 {
  "beat": 104,
  "chapter": 4,
  "text": "The wall is real. The Cyclopes were the Greeks' explanation for it.",
  "words": 12,
  "start": 488.902,
  "end": 492.978,
  "duration": 4.076,
  "first_word": 1263,
  "last_word": 1274,
  "new_paragraph": false
 },
 {
  "beat": 105,
  "chapter": 4,
  "text": "The Greeks did attach giants to things they could not explain.",
  "words": 11,
  "start": 493.419,
  "end": 496.739,
  "duration": 3.32,
  "first_word": 1275,
  "last_word": 1285,
  "new_paragraph": false
 },
 {
  "beat": 106,
  "chapter": 4,
  "text": "In Sicily, local tradition says the sea stacks at Aci Trezza are the boulders thrown at Odysseus.",
  "words": 17,
  "start": 497.18,
  "end": 503.346,
  "duration": 6.166,
  "first_word": 1286,
  "last_word": 1302,
  "new_paragraph": false
 },
 {
  "beat": 107,
  "chapter": 4,
  "text": "They are volcanic basalt, about half a million years old. That is legend, not archaeology.",
  "words": 15,
  "start": 503.787,
  "end": 510.358,
  "duration": 6.571,
  "first_word": 1303,
  "last_word": 1317,
  "new_paragraph": false
 },
 {
  "beat": 108,
  "chapter": 5,
  "text": "So where does that leave us? Start with what is solid.",
  "words": 11,
  "start": 512.358,
  "end": 515.644,
  "duration": 3.286,
  "first_word": 1318,
  "last_word": 1328,
  "new_paragraph": true
 },
 {
  "beat": 109,
  "chapter": 5,
  "text": "The Greeks told at least three different Cyclops stories, and kept them apart.",
  "words": 13,
  "start": 516.073,
  "end": 520.415,
  "duration": 4.342,
  "first_word": 1329,
  "last_word": 1341,
  "new_paragraph": false
 },
 {
  "beat": 110,
  "chapter": 5,
  "text": "A single eye is stated by Hesiod, Euripides, and Theocritus. Homer implies it.",
  "words": 13,
  "start": 520.915,
  "end": 527.126,
  "duration": 6.211,
  "first_word": 1342,
  "last_word": 1354,
  "new_paragraph": false
 },
 {
  "beat": 111,
  "chapter": 5,
  "text": "Dwarf elephants really lived on those islands, and their skulls really do have a hole in the middle.",
  "words": 18,
  "start": 527.37,
  "end": 532.328,
  "duration": 4.958,
  "first_word": 1355,
  "last_word": 1372,
  "new_paragraph": false
 },
 {
  "beat": 112,
  "chapter": 5,
  "text": "The blinding story itself is a folktale. Scholars have counted over two hundred versions,",
  "words": 14,
  "start": 532.757,
  "end": 538.191,
  "duration": 5.434,
  "first_word": 1373,
  "last_word": 1386,
  "new_paragraph": false
 },
 {
  "beat": 113,
  "chapter": 5,
  "text": "from Iceland to Korea, and most think the tale is older than Homer.",
  "words": 13,
  "start": 538.342,
  "end": 542.173,
  "duration": 3.831,
  "first_word": 1387,
  "last_word": 1399,
  "new_paragraph": false
 },
 {
  "beat": 114,
  "chapter": 5,
  "text": "That does not rule out the skull. It does mean the story does not need one.",
  "words": 16,
  "start": 542.544,
  "end": 546.735,
  "duration": 4.191,
  "first_word": 1400,
  "last_word": 1415,
  "new_paragraph": false
 },
 {
  "beat": 115,
  "chapter": 5,
  "text": "Now, what we cannot say. No surviving ancient text says anyone mistook a skull for a Cyclops.",
  "words": 17,
  "start": 547.328,
  "end": 553.806,
  "duration": 6.478,
  "first_word": 1416,
  "last_word": 1432,
  "new_paragraph": false
 },
 {
  "beat": 116,
  "chapter": 5,
  "text": "Other explanations compete: volcanic craters, smith guilds, even a birth defect called cyclopia,",
  "words": 13,
  "start": 554.305,
  "end": 561.109,
  "duration": 6.804,
  "first_word": 1433,
  "last_word": 1445,
  "new_paragraph": false
 },
 {
  "beat": 117,
  "chapter": 5,
  "text": "though in that condition the eye sits below the nose, not above it.",
  "words": 13,
  "start": 561.387,
  "end": 565.137,
  "duration": 3.75,
  "first_word": 1446,
  "last_word": 1458,
  "new_paragraph": false
 },
 {
  "beat": 118,
  "chapter": 5,
  "text": "Aguirre and Buxton's verdict is that each has an air of plausibility, and none has proof.",
  "words": 16,
  "start": 565.637,
  "end": 571.024,
  "duration": 5.387,
  "first_word": 1459,
  "last_word": 1474,
  "new_paragraph": false
 },
 {
  "beat": 119,
  "chapter": 5,
  "text": "The skull theory is a hypothesis. A plausible one, and still unproven.",
  "words": 12,
  "start": 571.453,
  "end": 576.771,
  "duration": 5.318,
  "first_word": 1475,
  "last_word": 1486,
  "new_paragraph": false
 },
 {
  "beat": 120,
  "chapter": 6,
  "text": "So, was the Cyclops real?",
  "words": 5,
  "start": 578.77,
  "end": 580.349,
  "duration": 1.579,
  "first_word": 1487,
  "last_word": 1491,
  "new_paragraph": true
 },
 {
  "beat": 121,
  "chapter": 6,
  "text": "As a one-eyed giant who eats sailors, no.",
  "words": 8,
  "start": 580.744,
  "end": 583.553,
  "duration": 2.809,
  "first_word": 1492,
  "last_word": 1499,
  "new_paragraph": false
 },
 {
  "beat": 122,
  "chapter": 6,
  "text": "But the name covers at least four different things:",
  "words": 9,
  "start": 584.076,
  "end": 586.607,
  "duration": 2.531,
  "first_word": 1500,
  "last_word": 1508,
  "new_paragraph": false
 },
 {
  "beat": 123,
  "chapter": 6,
  "text": "Hesiod's thunderbolt smiths, Homer's shepherd, a volcano's worth of Sicilian tradition,",
  "words": 11,
  "start": 587.06,
  "end": 592.597,
  "duration": 5.537,
  "first_word": 1509,
  "last_word": 1519,
  "new_paragraph": false
 },
 {
  "beat": 124,
  "chapter": 6,
  "text": "and walls you can still touch.",
  "words": 6,
  "start": 592.748,
  "end": 594.385,
  "duration": 1.637,
  "first_word": 1520,
  "last_word": 1525,
  "new_paragraph": false
 },
 {
  "beat": 125,
  "chapter": 6,
  "text": "The skull may be one more thread. It is a suspect, not a conviction.",
  "words": 14,
  "start": 594.838,
  "end": 599.273,
  "duration": 4.435,
  "first_word": 1526,
  "last_word": 1539,
  "new_paragraph": false
 },
 {
  "beat": 126,
  "chapter": 6,
  "text": "Odysseus leaves that island six men short, with a god's grudge.",
  "words": 11,
  "start": 599.726,
  "end": 603.708,
  "duration": 3.982,
  "first_word": 1540,
  "last_word": 1550,
  "new_paragraph": false
 },
 {
  "beat": 127,
  "chapter": 6,
  "text": "Next time: the winds, the witch, and the other monsters of the Odyssey.",
  "words": 13,
  "start": 604.161,
  "end": 608.271,
  "duration": 4.11,
  "first_word": 1551,
  "last_word": 1563,
  "new_paragraph": false
 },
 {
  "beat": 128,
  "chapter": 6,
  "text": "Some of them have real-world suspects too. We will see which survive.",
  "words": 12,
  "start": 608.724,
  "end": 612.973,
  "duration": 4.249,
  "first_word": 1564,
  "last_word": 1575,
  "new_paragraph": false
 },
 {
  "beat": 129,
  "chapter": 6,
  "text": "Subscribe if you would like us to keep checking.",
  "words": 9,
  "start": 613.426,
  "end": 615.829,
  "duration": 2.403,
  "first_word": 1576,
  "last_word": 1584,
  "new_paragraph": false
 }
]